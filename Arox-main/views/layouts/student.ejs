<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>
    <%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>
  </title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AROX Tech Student Portal">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>">
  <meta property="og:description" content="Access your enrolled courses, certificates, payments, and attendance records on the AROX Tech Student Portal.">
  <meta property="og:url" content="<%= org.website %><%= currentPath %>">
  <meta property="og:image" content="<%= org.website %>/assets/hero/home_light.png">
  <meta property="og:image:alt" content="AROX Tech Student Portal">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>">
  <meta name="twitter:description" content="Access your enrolled courses, certificates, payments, and attendance records on the AROX Tech Student Portal.">

  <!-- SEO -->
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#155EEF">

  <!-- Google Fonts: Montserrat (unified brand font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Montserrat', 'sans-serif'] },
          colors: {
            primary: { DEFAULT: '#155EEF', light: '#3B82F6', dark: '#0F4EBB' },
          }
        }
      }
    }
  </script>

  <!-- Chart.js for Dashboards -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/erp-assets/css/erp-theme.css">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/erp-assets/assets/logo/logo-dark.png">

  <%- style %>
</head>
<body class="erp-body">

  <!-- Skip to content (accessibility) -->
  <a href="#student-main-content" style="position:absolute;top:-100%;left:16px;z-index:99999;padding:12px 24px;background:#000;color:#fff;font-weight:600;font-size:14px;border-radius:0 0 8px 8px;text-decoration:none;transition:top 0.2s ease;" onfocus="this.style.top='0'" onblur="this.style.top='-100%'">
    Skip to main content
  </a>

  <!-- Sidebar Overlay (mobile) -->
  <div class="erp-sidebar-overlay" id="student-sidebar-overlay" aria-hidden="true"></div>

  <div class="erp-layout">
    <!-- Sidebar -->
    <aside class="erp-sidebar" id="student-sidebar">
      <script>
        // Inline script to prevent sidebar layout flash
        if (localStorage.getItem('sidebar-collapsed') === 'true') {
          document.getElementById('student-sidebar').classList.add('collapsed');
        }
      </script>
      <div class="erp-sidebar-header">
        <div class="sidebar-logo-container">
          <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo" class="sidebar-logo-large" style="height: 64px; max-height: 68px; width: auto; max-width: 220px; object-fit: contain;">
        </div>
        <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Toggle Sidebar">
          <i id="sidebar-toggle-icon" data-lucide="panel-left-close" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <nav class="erp-sidebar-nav">
        <a href="/student/dashboard" class="erp-nav-item <%= currentPath === '/student/dashboard' ? 'active' : '' %>">
          <i data-lucide="layout-dashboard"></i>
          <span>Overview</span>
        </a>
        <a href="/student/courses" class="erp-nav-item <%= currentPath.startsWith('/student/courses') ? 'active' : '' %>">
          <i data-lucide="book-open"></i>
          <span>My Courses</span>
        </a>
        <a href="/student/payments" class="erp-nav-item <%= currentPath.startsWith('/student/payments') ? 'active' : '' %>">
          <i data-lucide="wallet"></i>
          <span>Payments</span>
        </a>
        
        <div class="erp-nav-section">Account</div>

        <a href="/student/profile" class="erp-nav-item <%= currentPath.startsWith('/student/profile') ? 'active' : '' %>">
          <i data-lucide="user-circle-2"></i>
          <span>Profile</span>
        </a>
      </nav>

      <div style="padding: 20px 14px; border-top: 1px solid #E2E8F0;">
        <a href="/" class="erp-nav-item" style="margin-bottom: 8px;">
          <i data-lucide="home"></i>
          <span>Back to Website</span>
        </a>
        <form action="/api/auth/logout" method="POST" id="logoutForm">
          <button type="submit" class="erp-nav-item" style="width: 100%; border: none; background: transparent; cursor: pointer; text-align: left;">
            <i data-lucide="log-out"></i>
            <span>Logout</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="erp-main" id="student-main-content" role="main" aria-label="Student portal content">
      <!-- Topbar -->
      <header class="erp-topbar">
        <div style="display: flex; align-items: center; gap: 8px;">
          <button class="erp-mobile-toggle" id="student-mobile-toggle" aria-label="Open menu">
            <i data-lucide="menu" style="width: 22px; height: 22px;"></i>
          </button>
          <div class="erp-breadcrumb">
            <span style="color: var(--erp-text-secondary);">Portal</span>
            <i data-lucide="chevron-right" style="width: 14px; height: 14px; color: var(--erp-text-secondary);"></i>
            <span class="erp-breadcrumb-active"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Overview' %></span>
          </div>
        </div>

        <div class="erp-topbar-right">
          <button style="background: transparent; border: none; cursor: pointer; color: var(--erp-text-secondary);">
            <i data-lucide="bell" style="width: 20px; height: 20px;"></i>
          </button>

          <div class="erp-profile">
            <div style="display: flex; flex-direction: column; text-align: right;" class="hidden sm:flex">
              <span style="font-size: 13px; font-weight: 600;">
                <%= (typeof student !== 'undefined' && student) ? `${student.first_name} ${student.last_name}` : ((typeof user !== 'undefined' && user && user.email) ? user.email.split('@')[0] : 'Student') %>
              </span>
              <span style="font-size: 11px; color: var(--erp-text-secondary);">Student</span>
            </div>
            <div class="erp-avatar">
              <% if (typeof student !== 'undefined' && student && student.photo) { %>
                <img src="<%= student.photo %>" alt="Avatar" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
              <% } else { %>
                <%= (typeof user !== 'undefined' && user && user.email) ? user.email.charAt(0).toUpperCase() : 'S' %>
              <% } %>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="erp-content">
        <%- body %>
      </div>

      <!-- ERP Mobile Bottom Navigation Bar -->
      <nav class="erp-bottom-nav" aria-label="Mobile Navigation">
        <a href="/student/dashboard" class="erp-bottom-nav-item <%= currentPath === '/student/dashboard' ? 'active' : '' %>">
          <i data-lucide="layout-dashboard"></i>
          <span>Overview</span>
        </a>
        <a href="/student/courses" class="erp-bottom-nav-item <%= currentPath.startsWith('/student/courses') ? 'active' : '' %>">
          <i data-lucide="book-open"></i>
          <span>My Courses</span>
        </a>
        <a href="/student/payments" class="erp-bottom-nav-item <%= currentPath.startsWith('/student/payments') ? 'active' : '' %>">
          <i data-lucide="wallet"></i>
          <span>Payments</span>
        </a>
        <a href="/student/profile" class="erp-bottom-nav-item <%= currentPath.startsWith('/student/profile') ? 'active' : '' %>">
          <i data-lucide="user-circle-2"></i>
          <span>Profile</span>
        </a>
        <button type="button" class="erp-bottom-nav-item" id="student-bottom-menu-btn">
          <i data-lucide="menu"></i>
          <span>Menu</span>
        </button>
      </nav>
    </main>
  </div>

  <script>
    // Initialize all Lucide Icons
    lucide.createIcons();

    // Sidebar Toggle Controller
    document.addEventListener('DOMContentLoaded', () => {
      const sidebar = document.getElementById('student-sidebar');
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      const toggleIcon = document.getElementById('sidebar-toggle-icon');
      const mobileToggle = document.getElementById('student-mobile-toggle');
      const overlay = document.getElementById('student-sidebar-overlay');

      function updateToggleIcon(isCollapsed) {
        if (toggleIcon) {
          if (isCollapsed) {
            toggleIcon.setAttribute('data-lucide', 'panel-left-open');
          } else {
            toggleIcon.setAttribute('data-lucide', 'panel-left-close');
          }
          if (window.lucide) window.lucide.createIcons();
        }
      }

      function openMobileSidebar() {
        sidebar.classList.add('mobile-open');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeMobileSidebar() {
        sidebar.classList.remove('mobile-open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      // Desktop toggle
      const currentCollapsed = sidebar.classList.contains('collapsed');
      updateToggleIcon(currentCollapsed);

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isMobile = window.innerWidth <= 768;
          if (isMobile) {
            openMobileSidebar();
          } else {
            const collapsed = sidebar.classList.toggle('collapsed');
            localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false');
            updateToggleIcon(collapsed);
          }
        });
      }

      // Mobile hamburger & Bottom menu button
      if (mobileToggle) {
        mobileToggle.addEventListener('click', openMobileSidebar);
      }
      const bottomMenuBtn = document.getElementById('student-bottom-menu-btn');
      if (bottomMenuBtn) {
        bottomMenuBtn.addEventListener('click', openMobileSidebar);
      }
      if (overlay) {
        overlay.addEventListener('click', closeMobileSidebar);
      }

      // Close mobile sidebar on nav item click
      sidebar.querySelectorAll('.erp-nav-item').forEach(item => {
        item.addEventListener('click', () => {
          if (window.innerWidth <= 768) closeMobileSidebar();
        });
      });
    });
  </script>

  <%- script %>
</body>
</html>