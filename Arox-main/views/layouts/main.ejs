<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="description"
    content="AROX Tech - Premier Internship & Training Platform. Learn Full Stack Web Development, AI/ML, Mobile App Development with industry-recognized certificates.">
  <meta name="keywords"
    content="internship, training, web development, AI, machine learning, mobile app, certificates, AROX Tech">
  <meta name="author" content="AROX Tech Pvt. Ltd.">
  <title>
    <%= typeof title !=='undefined' ? title : 'AROX Tech' %>
  </title>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AROX Tech">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'AROX Tech - Premier Internship & Training Platform' %>">
  <meta property="og:description" content="AROX Tech - Premier Internship & Training Platform. Learn Full Stack Web Development, AI/ML, Mobile App Development with industry-recognized certificates.">
  <meta property="og:url" content="<%= org.website %><%= currentPath %>">
  <meta property="og:image" content="<%= org.website %>/assets/hero/home_light.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="AROX Tech - Premier Internship & Training Platform">
  <meta property="og:locale" content="en_IN">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'AROX Tech - Premier Internship & Training Platform' %>">
  <meta name="twitter:description" content="AROX Tech - Premier Internship & Training Platform. Learn Full Stack Web Development, AI/ML, Mobile App Development with industry-recognized certificates.">
  <meta name="twitter:image" content="<%= org.website %>/assets/hero/home_light.png">
  <meta name="twitter:site" content="@aroxtech">
  <meta name="twitter:creator" content="@aroxtech">

  <!-- Additional SEO -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <meta name="theme-color" content="#155EEF" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0c11" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="<%= org.website %><%= currentPath %>">

  <!-- Preconnect to critical third-party origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.tailwindcss.com">
  <link rel="preconnect" href="https://unpkg.com">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">

  <!-- Preload critical hero image for LCP -->
  <link rel="preload" as="image" href="/assets/hero/home_light.png" fetchpriority="high">

  <!-- Google Fonts: Montserrat with font-display:swap for FOUT prevention -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS v3 CDN (render-blocking required for layout) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Montserrat', 'sans-serif'] },
          colors: {
            primary: { DEFAULT: '#155EEF', light: '#3B82F6', dark: '#0F4EBB', 50: '#EBF2FF', 100: '#D6E4FF', 200: '#ADC9FF' },
            secondary: { DEFAULT: '#7C3AED', light: '#8B5CF6' },
            accent: { DEFAULT: '#06B6D4', light: '#22D3EE' },
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons (deferred - not needed for initial paint) -->
  <script src="https://unpkg.com/lucide@latest" defer></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/erp-assets/css/style.css">
  <link rel="stylesheet" href="/erp-assets/css/animations.css">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/erp-assets/assets/logo/logo-dark.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico">

  <!-- Structured Data: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "AROX Tech Pvt. Ltd.",
    "url": "<%= org.website %>",
    "logo": "<%= org.website %>/erp-assets/assets/logo/logo-dark.png",
    "description": "Premier internship and training platform for aspiring tech professionals.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Chennai",
      "addressRegion": "Tamil Nadu",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "<%= org.phone %>",
      "contactType": "customer service",
      "email": "<%= org.email %>"
    },
    "sameAs": []
  }
  </script>

  <!-- Structured Data: Website with SearchAction -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AROX Tech",
    "url": "<%= org.website %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= org.website %>/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <%- style %>
</head>

<body class="page-transition">
  <!-- Skip to content (accessibility) -->
  <a href="#main-content" class="skip-to-content" id="skip-to-content"
     style="position:absolute;top:-100%;left:16px;z-index:99999;padding:12px 24px;background:#000;color:#fff;font-weight:600;font-size:14px;border-radius:0 0 8px 8px;text-decoration:none;transition:top 0.2s ease;"
     onfocus="this.style.top='0'" onblur="this.style.top='-100%'">
    Skip to main content
  </a>

  <%- include('../partials/navbar') %>

    <main id="main-content" role="main" aria-label="Main content">
      <%- body %>
    </main>

    <%- include('../partials/footer') %>

      <!-- Theme Toggle -->
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <!-- Back to Top -->
      <button class="back-to-top" id="back-to-top" aria-label="Back to top" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>

      <!-- Mobile Menu Overlay -->
      <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

      <!-- Core JS (deferred) -->
      <script src="/erp-assets/js/app.js" defer></script>

      <!-- Initialize Lucide Icons + Navbar -->
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Init Lucide
          if (window.lucide) lucide.createIcons();

          // Navbar functionality
          var navbar = document.getElementById('navbar');
          var toggle = document.getElementById('navbar-toggle');
          var menu = document.getElementById('navbar-menu');
          var overlay = document.getElementById('mobile-overlay');

          if (!navbar || !toggle || !menu) return;

          // Scroll effect (passive for performance)
          function handleScroll() {
            if (window.scrollY > 50) {
              navbar.classList.add('scrolled');
            } else {
              navbar.classList.remove('scrolled');
            }
          }
          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll();

          // Mobile menu toggle with focus management
          function openMenu() {
            menu.classList.add('open');
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
            toggle.classList.add('active');
            toggle.setAttribute('aria-expanded', 'true');
            // Focus first link for accessibility
            var firstLink = menu.querySelector('a');
            if (firstLink) firstLink.focus();
          }

          function closeMenu() {
            menu.classList.remove('open');
            overlay.classList.remove('open');
            document.body.style.overflow = '';
            toggle.classList.remove('active');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus(); // Return focus to trigger
          }

          toggle.addEventListener('click', function() {
            if (menu.classList.contains('open')) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          overlay.addEventListener('click', closeMenu);

          // Close menu on nav link click
          menu.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', closeMenu);
          });

          // Close menu on Escape key
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && menu.classList.contains('open')) {
              closeMenu();
            }
          });

          // Close menu on resize to desktop
          window.addEventListener('resize', function() {
            if (window.innerWidth > 768) {
              closeMenu();
            }
          }, { passive: true });

          // Back to top
          var backBtn = document.getElementById('back-to-top');
          if (backBtn) {
            window.addEventListener('scroll', function() {
              backBtn.classList.toggle('visible', window.scrollY > 500);
            }, { passive: true });
            backBtn.addEventListener('click', function() {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          }

          // Smooth scroll for anchor links
          document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
            anchor.addEventListener('click', function(e) {
              var targetId = this.getAttribute('href');
              if (targetId === '#') return;
              var target = document.querySelector(targetId);
              if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          });
        });
      </script>

      <%- script %>
</body>

</html>
