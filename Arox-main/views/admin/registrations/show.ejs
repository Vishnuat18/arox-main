<div class="animate-fade-slide-up">
  <div class="grid-3">
    <!-- Main Registration Details -->
    <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Student Profile Card -->
      <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
          <div style="display: flex; gap: 16px; align-items: center;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--gradient-primary); color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; box-shadow: var(--shadow-sm); flex-shrink: 0;">
              <%= reg.first_name.charAt(0) %>
            </div>
            <div>
              <h2 style="font-size: 1.4rem; margin-bottom: 4px;"><%= reg.first_name %> <%= reg.last_name %></h2>
              <div style="font-size: 0.9rem; color: var(--text-muted);"><a href="/admin/students/<%= reg.student_id %>" style="color: var(--primary); text-decoration: none;">View Full Student Profile →</a></div>
            </div>
          </div>
          
          <div style="text-align: right;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 4px;">Registration ID</div>
            <div style="font-family: monospace; font-size: 1.1rem; font-weight: 700; color: var(--primary); background: var(--primary-50); padding: 4px 12px; border-radius: var(--radius-sm);"><%= reg.registration_id %></div>
          </div>
        </div>

        <div class="grid-2">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Email</div>
            <div style="font-weight: 500; margin-bottom: 16px;"><%= reg.email %></div>
            
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Phone / WhatsApp</div>
            <div style="font-weight: 500;"><%= reg.whatsapp_no || 'N/A' %></div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">College</div>
            <div style="font-weight: 500; margin-bottom: 16px;"><%= reg.college_name || 'N/A' %></div>
            
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Degree / Department</div>
            <div style="font-weight: 500;"><%= reg.degree || 'N/A' %><%= reg.department ? ' — ' + reg.department : '' %></div>
          </div>
        </div>

        <% if (reg.year_of_study) { %>
          <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);">
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Year of Study</div>
            <div style="font-weight: 500;"><%= reg.year_of_study %></div>
          </div>
        <% } %>
      </div>

      <!-- Course Details -->
      <div class="card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;">Course Information</h3>
        <div class="grid-2">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Course Enrolled</div>
            <div style="font-weight: 600; font-size: 1.1rem; margin-bottom: 4px;"><%= reg.course_title %></div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
              <span class="badge" style="background: var(--bg-secondary);">Batch: <%= reg.batch_name || 'General' %></span>
              <% if (reg.course_type) { %>
                <span class="badge" style="background: var(--primary-50); color: var(--primary); text-transform: capitalize;"><%= reg.course_type %></span>
              <% } %>
            </div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Course Fee</div>
            <div style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary);">₹<%= (reg.fee || 0).toLocaleString('en-IN') %></div>
          </div>
        </div>

        <!-- Course Schedule -->
        <% if (reg.start_date || reg.end_date || reg.duration) { %>
          <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
              <% if (reg.duration) { %>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Duration</div>
                  <div style="font-weight: 600;"><%= reg.duration %></div>
                </div>
              <% } %>
              <% if (reg.start_date) { %>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Start Date</div>
                  <div style="font-weight: 600;"><%= new Date(reg.start_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                </div>
              <% } %>
              <% if (reg.end_date) { %>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">End Date</div>
                  <div style="font-weight: 600;"><%= new Date(reg.end_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- Payment Summary -->
        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Total Amount</div>
              <div style="font-weight: 700;">₹<%= (reg.total_amount || reg.fee || 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Paid Amount</div>
              <div style="font-weight: 700; color: var(--success, #34A853);">₹<%= (reg.paid_amount || 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Balance Due</div>
              <div style="font-weight: 700; color: <%= (reg.balance_amount || 0) > 0 ? '#EA4335' : '#34A853' %>;">₹<%= (reg.balance_amount || 0).toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment History -->
      <div class="card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;">Payment History</h3>
        <% if (payments && payments.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Transaction ID</th>
                  <th>Amount</th>
                  <th>Method</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach(p => { %>
                  <tr>
                    <td style="white-space: nowrap;"><%= new Date(p.created_at || p.paid_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                    <td style="font-family: monospace; font-size: 0.85rem;"><%= p.transaction_id || p.invoice_number || '—' %></td>
                    <td style="font-weight: 600;">₹<%= (p.amount || 0).toLocaleString('en-IN') %></td>
                    <td style="text-transform: capitalize;"><%= p.method || p.payment_method || 'UPI' %></td>
                    <td>
                      <span class="status-badge <%= p.status === 'completed' || p.status === 'success' ? 'status-active' : (p.status === 'pending' ? 'status-pending' : 'status-error') %>">
                        <%= p.status || 'completed' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 24px; color: var(--text-muted);">
            No payments recorded yet for this registration.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Registration Status & Actions Sidebar -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <div class="card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;">Registration Status</h3>
        
        <div style="margin-bottom: 20px;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;">Current Status</div>
          <div>
            <% if (reg.status === 'completed' || reg.status === 'active') { %>
              <span class="status-badge status-active">Active</span>
            <% } else if (reg.status === 'pending_payment' || reg.status === 'pending') { %>
              <span class="status-badge status-pending">Pending Payment</span>
            <% } else if (reg.status === 'rejected') { %>
              <span class="status-badge status-error">Rejected</span>
            <% } else { %>
              <span class="status-badge status-inactive"><%= reg.status %></span>
            <% } %>
          </div>
        </div>

        <div style="margin-bottom: 20px;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px;">Enrolled Date</div>
          <div style="font-weight: 500;"><%= new Date(reg.created_at || reg.registration_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
        </div>

        <div style="border-top: 1px solid var(--border); padding-top: 16px;">
          <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 8px;">Update Status</label>
          <select id="statusSelect" class="form-control" style="margin-bottom: 12px; width: 100%;">
            <option value="pending_payment" <%= reg.status === 'pending_payment' ? 'selected' : '' %>>Pending Payment</option>
            <option value="completed" <%= reg.status === 'completed' || reg.status === 'active' ? 'selected' : '' %>>Completed / Active</option>
            <option value="cancelled" <%= reg.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="rejected" <%= reg.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
          <button type="button" onclick="updateRegistrationStatus('<%= reg.id %>')" class="btn btn-primary" style="width: 100%;">Update Status</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
async function updateRegistrationStatus(id) {
  const status = document.getElementById('statusSelect').value;
  try {
    const res = await fetch(`/admin/registrations/${id}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert(data.error || 'Failed to update status');
    }
  } catch (err) {
    alert('An error occurred while updating status');
  }
}
</script>
