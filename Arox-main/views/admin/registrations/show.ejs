<div class="animate-fade-slide-up">
  <div class="grid-3">
    <!-- Main Registration Details -->
    <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Student Profile Card -->
      <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
          <div style="display: flex; gap: 16px; align-items: center;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--gradient-primary); color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; box-shadow: var(--shadow-sm);">
              <%= reg.first_name.charAt(0) %>
            </div>
            <div>
              <h2 style="font-size: 1.4rem; margin-bottom: 4px;"><%= reg.first_name %> <%= reg.last_name %></h2>
              <div style="font-size: 0.9rem; color: var(--text-muted);"><a href="/admin/students/<%= reg.student_id %>" style="color: var(--primary); text-decoration: none;">View Full Student Profile →</a></div>
            </div>
          </div>
          
          <div style="text-align: right;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; margin-bottom: 4px;">Registration ID</div>
            <div style="font-family: monospace; font-size: 1.1rem; font-weight: 700; color: var(--primary); background: var(--primary-50); padding: 4px 12px; border-radius: var(--radius-sm);"><%= reg.registration_id %></div>
          </div>
        </div>

        <div class="grid-2">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Email</div>
            <div style="font-weight: 500; margin-bottom: 16px;"><%= reg.email %></div>
            
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Phone / WhatsApp</div>
            <div style="font-weight: 500;"><%= reg.whatsapp_no %></div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">College</div>
            <div style="font-weight: 500; margin-bottom: 16px;"><%= reg.college_name %></div>
            
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Degree</div>
            <div style="font-weight: 500;"><%= reg.degree %></div>
          </div>
        </div>
      </div>

      <!-- Course Details -->
      <div class="card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;">Course Information</h3>
        <div class="grid-2">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Course Enrolled</div>
            <div style="font-weight: 600; font-size: 1.1rem; margin-bottom: 4px;"><%= reg.course_title %></div>
            <span class="badge" style="background: var(--bg-secondary); margin-bottom: 16px;">Batch: <%= reg.batch_name %></span>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Course Fee</div>
            <div style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary);">₹<%= reg.fee.toLocaleString('en-IN') %></div>
          </div>
        </div>
      </div>

      <!-- Payment History -->
      <div class="card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;">Payment History</h3>
        <% if (payments && payments.length > 0) { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction ID</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(p => { %>
                <tr>
                  <td><%= new Date(p.created_at).toLocaleDateString() %></td>
                  <td style="font-family: monospace; font-size: 0.85rem;"><%= p.transaction_id || p.id %></td>
                  <td style="font-weight: 600;">₹<%= p.amount.toLocaleString('en-IN') %></td>
                  <td>
                    <% if (p.status === 'completed') { %>
                      <span class="status-badge status-active">Success</span>
                    <% } else if (p.status === 'failed') { %>
                      <span class="status-badge status-error">Failed</span>
                    <% } else { %>
                      <span class="status-badge status-pending"><%= p.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div style="text-align: center; color: var(--text-muted); padding: 20px;">
            No payments recorded yet.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Sidebar Actions -->
    <div>
      <div class="card" style="padding: 24px; position: sticky; top: 100px;">
        <h3 style="font-size: 1.1rem; margin-bottom: 20px;">Status & Actions</h3>
        
        <div style="margin-bottom: 24px;">
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; font-weight: 600;">Current Status</div>
          <select id="statusSelect" class="form-select" style="font-weight: 600; padding: 12px;" data-reg-id="<%= reg.id %>" onchange="handleRegStatusChange(this)">
            <option value="pending_document" <%= reg.status === 'pending_document' ? 'selected' : '' %>>Pending Documents</option>
            <option value="pending_payment" <%= reg.status === 'pending_payment' ? 'selected' : '' %>>Pending Payment</option>
            <option value="completed" <%= reg.status === 'completed' ? 'selected' : '' %>>Completed (Active)</option>
            <option value="rejected" <%= reg.status === 'rejected' ? 'selected' : '' %>>Rejected / Cancelled</option>
          </select>
        </div>

        <hr style="border: none; border-top: 1px solid var(--border); margin: 24px 0;">

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% if (reg.status === 'completed') { %>
            <a href="/api/registrations/<%= reg.id %>/offer-letter" target="_blank" class="btn btn-secondary" style="width: 100%; justify-content: center;"><i data-lucide="file"></i> Download Offer Letter</a>
          <% } %>
          <button class="btn btn-primary" style="width: 100%; justify-content: center;" onclick="alert('Email functionality coming soon')"><i data-lucide="mail"></i> Send Email to Student</button>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  function handleRegStatusChange(selectEl) {
    const id = selectEl.getAttribute('data-reg-id');
    const status = selectEl.value;
    updateStatus(id, status);
  }

  async function updateStatus(id, status) {
    try {
      const res = await fetch('/admin/registrations/' + id + '/status', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      
      if (!res.ok) {
        throw new Error('Failed to update status');
      }
      
      showToast('Registration status updated successfully', 'success');
    } catch (err) {
      showToast(err.message, 'error');
      setTimeout(() => window.location.reload(), 1000); // Revert UI
    }
  }
</script>

