<div class="animate-fade-slide-up">
  <div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <div class="search-input-wrapper">
        <span class="search-icon"><i data-lucide="search"></i></span>
        <input type="text" class="form-input" placeholder="Search Registration ID, Name..." data-table-search="registrations-table">
      </div>
      
      <select class="form-select" style="width: 200px;">
        <option value="all">All Statuses</option>
        <option value="completed">Completed</option>
        <option value="pending_payment">Pending Payment</option>
        <option value="pending_document">Pending Documents</option>
        <option value="rejected">Rejected</option>
      </select>
    </div>

    <div style="overflow-x: auto;">
      <table class="data-table" id="registrations-table">
        <thead>
          <tr>
            <th>ID / Date</th>
            <th>Student</th>
            <th>Course</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (registrations.length > 0) { %>
            <% registrations.forEach(reg => { %>
              <tr>
                <td>
                  <div style="font-family: monospace; font-weight: 700; color: var(--primary);"><%= reg.registration_id %></div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(reg.created_at).toLocaleDateString() %></div>
                </td>
                <td>
                  <div style="font-weight: 600;"><%= reg.first_name %> <%= reg.last_name %></div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);"><%= reg.email %></div>
                </td>
                <td>
                  <div style="font-weight: 500; max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= reg.course_title %>"><%= reg.course_title %></div>
                  <span class="badge" style="background: var(--bg-secondary); font-size: 0.65rem; padding: 2px 6px; text-transform: uppercase;"><%= reg.course_type %></span>
                </td>
                <td>
                  <% if (reg.status === 'completed') { %>
                    <span class="status-badge status-active">Completed</span>
                  <% } else if (reg.status === 'pending_payment') { %>
                    <span class="status-badge status-pending">Pending Payment</span>
                  <% } else if (reg.status === 'rejected') { %>
                    <span class="status-badge status-error">Rejected</span>
                  <% } else { %>
                    <span class="status-badge status-inactive"><%= reg.status %></span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <a href="/admin/registrations/<%= reg.id %>" class="btn btn-ghost" style="padding: 6px 12px; font-size: 0.85rem; white-space: nowrap;">Review</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                <div style="font-size: 2rem; margin-bottom: 8px;"><i data-lucide="file-text"></i></div>
                No registrations found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
