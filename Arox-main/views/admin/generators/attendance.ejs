<%- include('../../partials/generator-nav', { currentGenerator: 'attendance' }) %>

<div style="display: grid; grid-template-columns: 2fr 3fr; gap: 24px;">
  
  <!-- Left Side: Control Panel -->
  <div style="background: var(--erp-bg); border: var(--erp-border-width) solid var(--erp-border); border-radius: var(--erp-radius); padding: 24px; overflow-y: auto; max-height: calc(100vh - 220px); box-shadow: var(--erp-shadow-subtle);">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--erp-divider);">
      <i data-lucide="calendar-check" style="width: 18px; height: 18px; color: var(--erp-primary);"></i>
      <h3 style="font-size: 16px; font-weight: 700; color: var(--erp-text-primary); margin: 0;">Attendance Details</h3>
    </div>

    <!-- Student Selector -->
    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Quick Fill from Student</label>
      <select id="studentQuickFill" class="erp-input" onchange="fillFromStudent(this.value)" style="font-size: 13px;">
        <option value="">-- Select student to auto-fill --</option>
        <% if (typeof students !== 'undefined' && students.length > 0) { %>
          <% students.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %> (<%= s.student_id %>)</option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Candidate Name</label>
        <input type="text" id="inputName" class="erp-input" placeholder="e.g., John Doe" value="John Doe" style="font-size: 13px;">
      </div>
      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">College Name</label>
        <input type="text" id="inputCollege" class="erp-input" placeholder="e.g., ABC Institute of Technology" value="ABC Institute of Technology" style="font-size: 13px;">
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Department</label>
          <input type="text" id="inputDept" class="erp-input" placeholder="e.g., IT" value="IT" style="font-size: 13px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Year</label>
          <input type="text" id="inputYear" class="erp-input" placeholder="e.g., III Year" value="III Year" style="font-size: 13px;">
        </div>
      </div>
      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Internship / Course</label>
        <input type="text" id="inputIntern" class="erp-input" placeholder="e.g., Full Stack Web Development" value="Full Stack Web Development" style="font-size: 13px;">
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Month</label>
          <input type="text" id="inputMonth" class="erp-input" placeholder="e.g., August 2026" value="August 2026" style="font-size: 13px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Total Days</label>
          <input type="number" id="inputDays" class="erp-input" value="30" min="1" max="365" style="font-size: 13px;">
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Preview (60%, scrollable for multi-page) -->
  <div style="background: var(--erp-bg); border: var(--erp-border-width) solid var(--erp-border); border-radius: var(--erp-radius); overflow: hidden; max-height: calc(100vh - 220px); position: relative; display: flex; flex-direction: column; box-shadow: var(--erp-shadow-subtle);">
    
    <div style="padding: 10px 16px; background: var(--erp-bg-secondary); border-bottom: 1px solid var(--erp-divider); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary);">
        <i data-lucide="eye" style="width: 14px; height: 14px;"></i> Live Preview
      </div>
      <span style="font-size: 11px; color: var(--erp-text-secondary);">Attendance Sheet</span>
    </div>

    <div style="flex: 1; overflow-y: auto; overflow-x: hidden; background: #E8ECF2; display: flex; justify-content: center; padding: 16px;">
      <iframe id="certFrame" src="/attendance/index.html" style="width: 100%; max-width: 800px; min-height: 1100px; border: none; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); flex-shrink: 0;"></iframe>
    </div>

    <div style="padding: 10px 16px; background: var(--erp-bg); border-top: 1px solid var(--erp-divider); display: flex; gap: 8px; justify-content: center; flex-shrink: 0;">
      <button onclick="frame.contentWindow.postMessage({ type: 'EXPORT_PDF' }, '*');" class="erp-btn erp-btn-primary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="download" style="width: 14px; height: 14px;"></i> Download PDF
      </button>
      <button onclick="openFullscreen()" class="erp-btn erp-btn-secondary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="maximize" style="width: 14px; height: 14px;"></i> Fullscreen
      </button>
      <button onclick="window.print()" class="erp-btn erp-btn-secondary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="printer" style="width: 14px; height: 14px;"></i> Print
      </button>
    </div>
  </div>
</div>

<!-- Fullscreen Modal -->
<div id="fullscreenModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; padding: 24px; backdrop-filter: blur(4px);">
  <div style="position: relative; width: 100%; height: 100%; max-width: 1100px; max-height: 90vh; background: #fff; border-radius: var(--erp-radius); overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <div style="padding: 16px 24px; border-bottom: 1px solid var(--erp-divider); display: flex; justify-content: space-between; align-items: center; background: var(--erp-bg-secondary);">
      <h3 style="font-size: 14px; font-weight: 700; color: var(--erp-text-primary); margin: 0;">Attendance Preview</h3>
      <button onclick="closeFullscreen()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: var(--erp-text-secondary);">&times;</button>
    </div>
    <div style="flex: 1; background: #F3F4F6; display: flex; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 16px;">
      <iframe id="fullscreenFrame" style="width: 100%; max-width: 900px; height: 1100px; border: none; border-radius: 6px;"></iframe>
    </div>
  </div>
</div>

<script>
  var frame = document.getElementById('certFrame');
  var studentDb = {};

  <% if (typeof students !== 'undefined' && students.length > 0) { %>
    <% students.forEach(function(s) { %>
      studentDb['<%= s.id %>'] = { name: '<%= s.first_name %> <%= s.last_name %>', college: '<%= (s.college || "N/A").replace(/'/g, "\\'") %>', dept: '<%= (s.department || "IT").replace(/'/g, "\\'") %>', course: '<%= (s.course_title || "Full Stack Web Development").replace(/'/g, "\\'") %>' };
    <% }) %>
  <% } %>

  function fillFromStudent(id) {
    if (!id || !studentDb[id]) return;
    var s = studentDb[id];
    document.getElementById('inputName').value = s.name;
    document.getElementById('inputCollege').value = s.college;
    document.getElementById('inputDept').value = s.dept;
    document.getElementById('inputIntern').value = s.course;
    updatePreview();
  }

  function updatePreview() {
    if (!frame.contentWindow) return;
    var data = {
      name: document.getElementById('inputName').value,
      college: document.getElementById('inputCollege').value,
      dept: document.getElementById('inputDept').value,
      year: document.getElementById('inputYear').value,
      intern: document.getElementById('inputIntern').value,
      month: document.getElementById('inputMonth').value,
      days: document.getElementById('inputDays').value
    };
    frame.contentWindow.postMessage({ type: 'UPDATE_DATA', data: data }, '*');
  }

  ['inputName', 'inputCollege', 'inputDept', 'inputYear', 'inputIntern', 'inputMonth', 'inputDays'].forEach(function(id) {
    document.getElementById(id).addEventListener('input', updatePreview);
  });

  frame.onload = function() { setTimeout(updatePreview, 600); };
  setTimeout(updatePreview, 1000);

  function openFullscreen() {
    document.getElementById('fullscreenModal').style.display = 'flex';
    var fsFrame = document.getElementById('fullscreenFrame');
    fsFrame.src = '/attendance/index.html';
    fsFrame.onload = function() { setTimeout(updatePreview, 500); };
  }
  function closeFullscreen() {
    document.getElementById('fullscreenModal').style.display = 'none';
    document.getElementById('fullscreenFrame').src = '';
  }

  lucide.createIcons();
</script>
