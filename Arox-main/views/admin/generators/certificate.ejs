<%- include('../../partials/generator-nav', { currentGenerator: 'certificate' }) %>

<div style="display: grid; grid-template-columns: 2fr 3fr; gap: 24px;">
  
  <!-- Left Side: Control Panel -->
  <div style="background: var(--erp-bg); border: var(--erp-border-width) solid var(--erp-border); border-radius: var(--erp-radius); padding: 24px; overflow-y: auto; max-height: calc(100vh - 180px); box-shadow: var(--erp-shadow-subtle);">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--erp-divider);">
      <i data-lucide="award" style="width: 18px; height: 18px; color: var(--erp-primary);"></i>
      <h3 style="font-size: 16px; font-weight: 700; color: var(--erp-text-primary); margin: 0;">Student Details</h3>
    </div>
    
    <!-- Student Selector -->
    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Quick Fill from Student</label>
      <select id="studentQuickFill" class="erp-input" onchange="fillFromStudent(this.value)" style="font-size: 13px;">
        <option value="">-- Select student to auto-fill --</option>
        <% if (typeof students !== 'undefined' && students.length > 0) { %>
          <% students.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %> (<%= s.student_id %>)</option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div id="erpFormFields" style="display: flex; flex-direction: column; gap: 14px;">
      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Student Name</label>
        <input type="text" id="inputName" class="erp-input" placeholder="e.g., John Doe" value="John Doe" style="font-size: 13px;">
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Domain</label>
        <select id="inputDomainSelect" class="erp-input" onchange="document.getElementById('inputDomain').value = this.value; updatePreview();" style="font-size: 13px;">
          <option value="Full Stack Web Development">Full Stack Web Development</option>
          <option value="UI & UX Design">UI & UX Design</option>
          <option value="Data Science & AI">Data Science & AI</option>
          <option value="Cyber Security">Cyber Security</option>
          <option value="Digital Marketing">Digital Marketing</option>
          <option value="Embedded Systems & IoT">Embedded Systems & IoT</option>
          <option value="DevOps Engineering">DevOps Engineering</option>
          <option value="Software Development">Software Development</option>
          <option value="App Development">App Development</option>
        </select>
        <input type="hidden" id="inputDomain" value="Full Stack Web Development">
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Date of Issue</label>
        <input type="date" id="inputIssueDate" class="erp-input" style="font-size: 13px;">
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Certificate ID</label>
        <div style="display: flex; gap: 6px; align-items: center;">
          <span style="font-weight: 600; font-size: 13px; color: var(--erp-text-primary);">AT/INT/</span>
          <input type="text" id="inputCertYear" class="erp-input" value="2026" style="width: 70px; text-align: center; font-size: 13px;">
          <span style="font-weight: 600; font-size: 13px; color: var(--erp-text-primary);">/</span>
          <input type="text" id="inputCertNum" class="erp-input" value="0101" style="flex: 1; text-align: center; font-size: 13px;">
        </div>
        <input type="hidden" id="inputCertId" value="AT/INT/2026/0101">
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Appreciation Text</label>
        <textarea id="inputDescription" class="erp-input" rows="3" style="font-size: 13px; resize: vertical;">During this internship, he/she was found to be dedicated, enthusiastic and hardworking. We wish him/her all the best for future endeavors.</textarea>
      </div>
    </div>
  </div>

  <!-- Right Side: Certificate Preview (60%) -->
  <div style="background: var(--erp-bg); border: var(--erp-border-width) solid var(--erp-border); border-radius: var(--erp-radius); overflow: hidden; max-height: calc(100vh - 180px); position: relative; display: flex; flex-direction: column; box-shadow: var(--erp-shadow-subtle);">
    
    <div style="padding: 10px 16px; background: var(--erp-bg-secondary); border-bottom: 1px solid var(--erp-divider); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--erp-text-secondary);">
        <i data-lucide="eye" style="width: 14px; height: 14px;"></i> Live Preview
      </div>
      <span style="font-size: 11px; color: var(--erp-text-secondary);">Certificate &bull; A4 Landscape</span>
    </div>

    <div id="certPreviewWrap" style="flex: 1; position: relative; overflow: hidden; background: #ffffff;">
      <iframe id="certFrame" src="/cert/index.html" style="width: 794px; height: 1123px; border: none; position: absolute; top: 0; left: 0; transform-origin: center center;"></iframe>
    </div>

    <div style="padding: 10px 16px; background: var(--erp-bg); border-top: 1px solid var(--erp-divider); display: flex; gap: 8px; justify-content: center; flex-shrink: 0;">
      <button onclick="frame.contentWindow.postMessage({ type: 'EXPORT_PDF' }, '*');" class="erp-btn erp-btn-primary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="download" style="width: 14px; height: 14px;"></i> Download PDF
      </button>
      <button onclick="openFullscreen()" class="erp-btn erp-btn-secondary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="maximize" style="width: 14px; height: 14px;"></i> Fullscreen
      </button>
      <button onclick="frame.contentWindow.postMessage({ type: 'PRINT' }, '*');" class="erp-btn erp-btn-secondary" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 12px;">
        <i data-lucide="printer" style="width: 14px; height: 14px;"></i> Print
      </button>
    </div>
  </div>
</div>

<!-- Fullscreen Modal -->
<div id="fullscreenModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(4px);">
  <div style="position: relative; width: 100%; height: 100%; max-width: 1200px; max-height: 96vh; background: #fff; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <div style="padding: 14px 20px; border-bottom: 1px solid var(--erp-divider); display: flex; justify-content: space-between; align-items: center; background: #fafafa; flex-shrink: 0;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i data-lucide="maximize-2" style="width: 18px; color: var(--erp-primary);"></i>
        <h3 style="font-size: 14px; font-weight: 700; color: var(--erp-text-primary); margin: 0;">Certificate Preview</h3>
      </div>
      <button onclick="closeFullscreen()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: var(--erp-text-secondary); line-height: 1;">&times;</button>
    </div>
    <div id="fsContainer" style="flex: 1; background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; padding: 0;">
      <iframe id="fullscreenFrame" style="border: none; position: absolute;"></iframe>
    </div>
  </div>
</div>

<div id="studentsData" style="display: none;" data-students="<%= Buffer.from(JSON.stringify(typeof students !== 'undefined' ? students : [])).toString('base64') %>"></div>

<script>
  var frame = document.getElementById('certFrame');
  var studentDb = {};

  (function() {
    var studentsDataEl = document.getElementById('studentsData');
    if (studentsDataEl) {
      var raw = studentsDataEl.getAttribute('data-students') || '';
      if (raw) {
        try {
          var list = JSON.parse(atob(raw));
          list.forEach(function(s) {
            studentDb[s.id] = {
              name: (s.first_name + ' ' + (s.last_name || '')).trim(),
              course: s.course_title || 'Full Stack Web Development',
              id: s.student_id
            };
          });
        } catch(e) {}
      }
    }
  })();

  function fillFromStudent(id) {
    if (!id || !studentDb[id]) return;
    var s = studentDb[id];
    document.getElementById('inputName').value = s.name;
    
    // Parse Cert ID if it has year and number
    var certMatch = String(s.id).match(/AT\/INT\/(\d{4})\/(\d+)/i) || String(s.id).match(/(\d{4})\/(\d+)/);
    if (certMatch) {
      document.getElementById('inputCertYear').value = certMatch[1];
      document.getElementById('inputCertNum').value = certMatch[2];
    } else {
      document.getElementById('inputCertNum').value = s.id ? s.id.replace(/[^0-9]/g, '').slice(-4) || '0100' : '0100';
    }

    if (s.course) {
      var sel = document.getElementById('inputDomainSelect');
      if (sel) {
        var found = false;
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value.toLowerCase() === s.course.toLowerCase()) {
            sel.selectedIndex = i;
            found = true;
            break;
          }
        }
        if (!found) {
          sel.value = s.course;
        }
      }
      document.getElementById('inputDomain').value = s.course;
    }
    updatePreview();
  }

  // Set default issue date to today if empty
  var issueDateEl = document.getElementById('inputIssueDate');
  if (issueDateEl && !issueDateEl.value) {
    issueDateEl.value = new Date().toISOString().slice(0, 10);
  }

  // Auto-select first real student on load if available
  window.addEventListener('DOMContentLoaded', function() {
    var quickFill = document.getElementById('studentQuickFill');
    if (quickFill && quickFill.options.length > 1) {
      quickFill.selectedIndex = 1;
      fillFromStudent(quickFill.value);
    }
  });

  function updatePreview() {
    var name = document.getElementById('inputName').value;
    var domain = document.getElementById('inputDomain').value;
    var date = document.getElementById('inputIssueDate').value;
    var year = document.getElementById('inputCertYear').value;
    var num = document.getElementById('inputCertNum').value;
    var certId = 'AT/INT/' + year + '/' + num;
    document.getElementById('inputCertId').value = certId;
    var desc = document.getElementById('inputDescription').value;
    var payloadCert = { type: 'UPDATE_CERT', data: { name: name, domain: domain, course: domain, date: date, issueDate: date, certId: certId, desc: desc } };
    var payloadData = { type: 'UPDATE_DATA', data: { name: name, domain: domain, course: domain, date: date, issueDate: date, certId: certId, desc: desc } };

    if (frame && frame.contentWindow) {
      frame.contentWindow.postMessage(payloadCert, '*');
      frame.contentWindow.postMessage(payloadData, '*');
    }
    var fsFrame = document.getElementById('fullscreenFrame');
    if (fsFrame && fsFrame.contentWindow) {
      fsFrame.contentWindow.postMessage(payloadCert, '*');
      fsFrame.contentWindow.postMessage(payloadData, '*');
    }
  }

  ['inputName', 'inputIssueDate', 'inputCertYear', 'inputCertNum', 'inputDescription'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', updatePreview);
  });

  function scaleCertPreview() {
    var wrap = document.getElementById('certPreviewWrap');
    var iframe = document.getElementById('certFrame');
    if (!wrap || !iframe) return;
    var wrapW = wrap.clientWidth, wrapH = wrap.clientHeight;
    var certW = 794, certH = 1123;
    if (wrapW <= 0 || wrapH <= 0) return;
    var pad = 16;
    var scale = Math.min((wrapW - pad) / certW, (wrapH - pad) / certH);
    
    iframe.style.width = certW + 'px';
    iframe.style.height = certH + 'px';
    iframe.style.position = 'absolute';
    iframe.style.transformOrigin = 'center center';
    iframe.style.left = Math.round((wrapW - certW) / 2) + 'px';
    iframe.style.top = Math.round((wrapH - certH) / 2) + 'px';
    iframe.style.transform = 'scale(' + scale + ')';
  }

  frame.onload = function() { 
    setTimeout(scaleCertPreview, 300); 
    setTimeout(updatePreview, 600); 
  };
  window.addEventListener('load', function() { 
    setTimeout(scaleCertPreview, 400); 
    setTimeout(updatePreview, 800); 
  });
  window.addEventListener('resize', scaleCertPreview);
  setTimeout(scaleCertPreview, 1000);
  setTimeout(scaleCertPreview, 2000);

  function openFullscreen() {
    document.getElementById('fullscreenModal').style.display = 'flex';
    var fsFrame = document.getElementById('fullscreenFrame');
    fsFrame.src = '/cert/index.html';
    fsFrame.onload = function() { 
      setTimeout(scaleFullscreenCert, 300);
      setTimeout(updatePreview, 600);
    };
  }

  function closeFullscreen() {
    document.getElementById('fullscreenModal').style.display = 'none';
    document.getElementById('fullscreenFrame').src = '';
  }

  function scaleFullscreenCert() {
    var container = document.getElementById('fsContainer');
    var fsFrame = document.getElementById('fullscreenFrame');
    if (!container || !fsFrame) return;
    var wrapW = container.clientWidth, wrapH = container.clientHeight;
    var certW = 794, certH = 1123;
    if (wrapW <= 0 || wrapH <= 0) return;
    var pad = 16;
    var scale = Math.min((wrapW - pad) / certW, (wrapH - pad) / certH);

    fsFrame.style.width = certW + 'px';
    fsFrame.style.height = certH + 'px';
    fsFrame.style.position = 'absolute';
    fsFrame.style.transformOrigin = 'center center';
    fsFrame.style.left = Math.round((wrapW - certW) / 2) + 'px';
    fsFrame.style.top = Math.round((wrapH - certH) / 2) + 'px';
    fsFrame.style.transform = 'scale(' + scale + ')';
  }

        updatePreview();
      }, 300); 
    };
    setTimeout(scaleFullscreenCert, 150);
  }
  function closeFullscreen() {
    document.getElementById('fullscreenModal').style.display = 'none';
    document.getElementById('fullscreenFrame').src = '';
  }

  window.addEventListener('resize', function() {
    scaleCertPreview();
    if (document.getElementById('fullscreenModal').style.display === 'flex') {
      scaleFullscreenCert();
    }
  });

  lucide.createIcons();
</script>
