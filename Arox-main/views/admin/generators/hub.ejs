<div id="studentsData" style="display: none;" data-students="<%= Buffer.from(JSON.stringify(typeof students !== 'undefined' ? students : [])).toString('base64') %>"></div>

<!-- JSZip for ZIP download -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<script>
  const studentDb = {};
  (function() {
    const studentsDataEl = document.getElementById('studentsData');
    if (studentsDataEl) {
      const studentsRaw = studentsDataEl.getAttribute('data-students') || '';
      if (studentsRaw) {
        try {
          const studentsList = JSON.parse(atob(studentsRaw));
          studentsList.forEach(s => {
            studentDb[s.id] = {
              name: `${s.first_name} ${s.last_name}`,
              email: s.email,
              id: s.student_id,
              course: s.course_title || 'N/A',
              college: s.college || 'N/A',
              dept: s.department || 'N/A',
              batch: s.batch_name || 'N/A',
              start: s.start_date || '',
              end: s.end_date || '',
              startText: s.start_date ? new Date(s.start_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A',
              endText: s.end_date ? new Date(s.end_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A',
              project: "Capstone Project",
              location: "Chennai",
              payment: s.reg_status === 'confirmed' ? 'Paid' : 'Pending',
              issueDate: new Date().toISOString().split('T')[0]
            };
          });
        } catch (e) {
          console.error("Error parsing student data:", e);
        }
      }
    }
  })();

  let currentStudent = null;
  let currentStudentDbId = null;
  let currentDoc = null;
  let selectedDocs = new Set();
  let currentZoom = 1.0;
  const frame = document.getElementById('certFrame');

  const routeMap = {
    'certificate': '/cert/index.html',
    'attendance': '/attendance/index.html',
    'offerletter': '/offerletter/index.html',
    'project': '/project/index.html'
  };

  // Certificate dimensions for fit-to-preview scaling
  const certDimensions = {
    'certificate': { w: 794, h: 1123 },
    'project': { w: 794, h: 1123 },
    'offerletter': { w: 800, h: 1100 },
    'attendance': { w: 800, h: 1100 }
  };

  function loadStudent(studentId) {
    currentStudentDbId = studentId;
    currentStudent = studentDb[studentId];
    if (!currentStudent) return;

    document.getElementById('stName').innerText = currentStudent.name;
    document.getElementById('stId').innerText = `ID: ${currentStudent.id}`;
    document.getElementById('stCourse').innerText = currentStudent.course;
    document.getElementById('stBatch').innerText = currentStudent.batch;
    document.getElementById('stPay').innerText = currentStudent.payment;
    
    if (currentDoc) updateSandbox();
  }

  function viewStudentProfile() {
    if (currentStudentDbId) {
      window.location.href = `/admin/students/${currentStudentDbId}`;
    } else {
      alert("Please select a student first.");
    }
  }

  function toggleDoc(el, docType) {
    if (selectedDocs.has(docType)) {
      // Unselect document
      selectedDocs.delete(docType);
      el.classList.remove('selected');
      el.classList.remove('active');

      if (currentDoc === docType) {
        if (selectedDocs.size > 0) {
          // Switch to another selected document
          const nextDoc = Array.from(selectedDocs)[selectedDocs.size - 1];
          currentDoc = nextDoc;
          document.querySelectorAll('.doc-list-item').forEach(item => {
            if (item.getAttribute('data-doc') === nextDoc) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
          frame.src = routeMap[nextDoc];
          frame.onload = () => {
            setTimeout(() => {
              updateSandbox();
              scalePreview();
            }, 300);
          };
        } else {
          // No document selected
          currentDoc = null;
          document.getElementById('overlay').style.display = 'flex';
          frame.src = 'about:blank';
        }
      }
    } else {
      // Select document
      selectedDocs.add(docType);
      el.classList.add('selected');
      
      // Set as active preview
      currentDoc = docType;
      document.querySelectorAll('.doc-list-item').forEach(item => item.classList.remove('active'));
      el.classList.add('active');

      document.getElementById('overlay').style.display = 'none';

      frame.src = routeMap[docType];
      frame.onload = () => {
        setTimeout(() => {
          updateSandbox();
          scalePreview();
        }, 300);
      };
    }

    updateSelectedCount();
  }

  function toggleSelectAllDocs() {
    const allDocTypes = ['offerletter', 'certificate', 'attendance', 'project'];
    const btn = document.getElementById('btnToggleAll');
    if (selectedDocs.size === allDocTypes.length) {
      // Deselect all
      selectedDocs.clear();
      document.querySelectorAll('.doc-list-item').forEach(e => {
        e.classList.remove('selected');
        e.classList.remove('active');
      });
      currentDoc = null;
      document.getElementById('overlay').style.display = 'flex';
      frame.src = 'about:blank';
      if (btn) btn.textContent = 'Select All';
    } else {
      // Select all
      allDocTypes.forEach(d => selectedDocs.add(d));
      document.querySelectorAll('.doc-list-item').forEach(e => e.classList.add('selected'));
      if (!currentDoc) {
        currentDoc = 'certificate';
        const certEl = document.querySelector('.doc-list-item[data-doc="certificate"]');
        if (certEl) certEl.classList.add('active');
        document.getElementById('overlay').style.display = 'none';
        frame.src = routeMap['certificate'];
        frame.onload = () => {
          setTimeout(() => {
            updateSandbox();
            scalePreview();
          }, 300);
        };
      }
      if (btn) btn.textContent = 'Deselect All';
    }
    updateSelectedCount();
  }

  function updateSelectedCount() {
    const count = selectedDocs.size;
    const badge = document.getElementById('selBadge');
    const countBar = document.getElementById('selectedCountBar');
    const countText = document.getElementById('selCountText');
    const btn = document.getElementById('btnToggleAll');
    
    if (count > 0) {
      badge.style.display = 'inline-flex';
      badge.textContent = count;
      countBar.style.display = 'block';
      countText.textContent = count;
    } else {
      badge.style.display = 'none';
      countBar.style.display = 'none';
    }

    if (btn) {
      btn.textContent = count === 4 ? 'Deselect All' : 'Select All';
    }
  }

  function scalePreview() {
    if (!currentDoc) return;
    const previewArea = document.getElementById('previewArea');
    if (!previewArea) return;
    const wrapW = previewArea.clientWidth;
    const wrapH = previewArea.clientHeight;
    if (wrapW <= 0 || wrapH <= 0) return;
    const dim = certDimensions[currentDoc] || { w: 794, h: 1123 };
    
    const pad = 16;
    const availW = Math.max(wrapW - pad, 100);
    const availH = Math.max(wrapH - pad, 100);
    const baseScale = Math.min(availW / dim.w, availH / dim.h);
    const totalScale = baseScale * currentZoom;
    
    frame.style.width = dim.w + 'px';
    frame.style.height = dim.h + 'px';
    frame.style.position = 'absolute';
    frame.style.transformOrigin = 'center center';
    frame.style.left = Math.round((wrapW - dim.w) / 2) + 'px';
    frame.style.top = Math.round((wrapH - dim.h) / 2) + 'px';
    frame.style.transform = `scale(${totalScale})`;
  }

  window.addEventListener('resize', scalePreview);

  function getPayloadForDoc(docType) {
    if (!currentStudent) return {};
    if (docType === 'certificate') {
      return {
        name: currentStudent.name, domain: currentStudent.course, date: currentStudent.issueDate, certId: currentStudent.id,
        desc: "During this internship, he/she was found to be dedicated, enthusiastic and hardworking."
      };
    } else if (docType === 'attendance') {
      return {
        name: currentStudent.name, college: currentStudent.college, dept: currentStudent.dept, year: "Final Year",
        intern: currentStudent.course, month: currentStudent.startText, days: 45
      };
    } else if (docType === 'offerletter') {
      return {
        candidateName: currentStudent.name, candidateAddress: currentStudent.college, roleTitle: `${currentStudent.course} Intern`,
        location: currentStudent.location, startDate: currentStudent.start, endDate: currentStudent.end,
        stipendAmount: "₹5,000 – ₹8,000 per month"
      };
    } else if (docType === 'project') {
      return {
        'cert-id-input': currentStudent.id, 'issue-date-input': currentStudent.issueDate, 'name-input': currentStudent.name,
        'project-input': currentStudent.project, 'start-date-input': currentStudent.startText, 'end-date-input': currentStudent.endText
      };
    }
    return {};
  }

  function updateSandbox() {
    if (!currentStudent || !currentDoc || !frame.contentWindow) return;
    const payload = getPayloadForDoc(currentDoc);
    frame.contentWindow.postMessage({ type: 'UPDATE_DATA', data: payload }, '*');
    if (currentDoc === 'certificate') frame.contentWindow.postMessage({ type: 'UPDATE_CERT', data: payload }, '*');
  }

  function zoomPreview(delta) {
    if (delta === 0) currentZoom = 1.0;
    else currentZoom = Math.max(0.4, Math.min(1.8, currentZoom + delta));
    
    document.getElementById('zoomVal').innerText = `${Math.round(currentZoom * 100)}%`;
    scalePreview();
  }

  function scaleFullscreenPreview() {
    const fsContainer = document.getElementById('fsContainer');
    const fsFrame = document.getElementById('fullscreenFrame');
    if (!fsContainer || !fsFrame || !currentDoc) return;
    
    const wrapW = fsContainer.clientWidth;
    const wrapH = fsContainer.clientHeight;
    const dim = certDimensions[currentDoc] || { w: 794, h: 1123 };
    
    if (currentDoc === 'offerletter' || currentDoc === 'attendance') {
      // Allow scroll for multi-page offer letter and extended attendance
      fsContainer.style.overflowY = 'auto';
      fsContainer.style.overflowX = 'hidden';
      fsContainer.style.display = 'block';
      fsFrame.style.position = 'relative';
      fsFrame.style.width = '100%';
      fsFrame.style.height = 'auto';
      fsFrame.style.minHeight = '1400px';
      fsFrame.style.transform = 'none';
      fsFrame.style.left = '0';
      fsFrame.style.top = '0';
    } else {
      // Single-page certificates (certificate, project): NO scroll, 100% fits perfectly in view
      fsContainer.style.overflow = 'hidden';
      fsContainer.style.display = 'flex';
      
      const pad = 16;
      const availW = Math.max(wrapW - pad, 100);
      const availH = Math.max(wrapH - pad, 100);
      const scale = Math.min(availW / dim.w, availH / dim.h);
      
      fsFrame.style.width = dim.w + 'px';
      fsFrame.style.height = dim.h + 'px';
      fsFrame.style.position = 'absolute';
      fsFrame.style.transformOrigin = 'center center';
      fsFrame.style.left = `${(wrapW - dim.w) / 2}px`;
      fsFrame.style.top = `${(wrapH - dim.h) / 2}px`;
      fsFrame.style.transform = `scale(${scale})`;
    }
  }

  function openFullscreenPreview() {
    if (!currentStudent || !currentDoc) {
      alert("Please select a student and document first.");
      return;
    }
    const modal = document.getElementById('fullscreenModal');
    const fsFrame = document.getElementById('fullscreenFrame');
    modal.style.display = 'flex';
    document.getElementById('fsModalTitle').textContent = `${currentDoc.charAt(0).toUpperCase() + currentDoc.slice(1)} Preview`;
    
    fsFrame.src = routeMap[currentDoc];
    fsFrame.onload = () => {
      setTimeout(() => {
        scaleFullscreenPreview();
        const payload = getPayloadForDoc(currentDoc);
        fsFrame.contentWindow.postMessage({ type: 'UPDATE_DATA', data: payload }, '*');
        if (currentDoc === 'certificate') fsFrame.contentWindow.postMessage({ type: 'UPDATE_CERT', data: payload }, '*');
      }, 300);
    };
    setTimeout(scaleFullscreenPreview, 150);
  }

  function closeFullscreenPreview() {
    const modal = document.getElementById('fullscreenModal');
    const fsFrame = document.getElementById('fullscreenFrame');
    modal.style.display = 'none';
    fsFrame.src = '';
  }

  window.addEventListener('resize', () => {
    scalePreview();
    if (document.getElementById('fullscreenModal').style.display === 'flex') {
      scaleFullscreenPreview();
    }
  });

  function showToast(msg) {
    const toast = document.getElementById('toastSuccess');
    document.getElementById('toastMsg').innerText = msg;
    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';
    setTimeout(() => { 
      toast.style.opacity = '0'; 
      toast.style.transform = 'translateY(20px)'; 
    }, 3000);
  }

  async function fireAction(action) {
    if (!currentStudent || !currentDoc || !currentStudentDbId) {
      alert("Please select a student and document first.");
      return;
    }

    if (action === 'generate' || action === 'download') {
      if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'EXPORT_PDF' }, '*');
      
      try {
        await fetch('/api/registrations/log-download', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ student_id: currentStudentDbId, document_type: currentDoc })
        });
      } catch(e) {}

      showToast("Document generated and downloading!");
    } else if (action === 'print') {
      if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'PRINT' }, '*');
    } else if (action === 'email') {
      showToast("Email sent to " + currentStudent.email);
    } else if (action === 'whatsapp') {
      showToast("WhatsApp message dispatched.");
    } else if (action === 'save') {
      showToast("Saved securely to Student Portal.");
    }
  }

  // Multi-select ZIP Download
  async function downloadSelectedZip() {
    if (!currentStudent || !currentStudentDbId) {
      alert("Please select a student first.");
      return;
    }

    if (selectedDocs.size === 0) {
      alert("Please select at least one document to download.");
      return;
    }

    showToast(`Generating ${selectedDocs.size} document(s) as ZIP... Please wait.`);

    const zip = new JSZip();
    const folderName = `${currentStudent.name.replace(/\s+/g, '_')}_documents`;
    const docFolder = zip.folder(folderName);
    
    let generatedCount = 0;
    for (const docType of selectedDocs) {
      try {
        const pdfBlob = await generatePdfBlob(docType);
        if (pdfBlob) {
          docFolder.file(`${docType}.pdf`, pdfBlob);
          generatedCount++;
          
          try {
            fetch('/api/registrations/log-download', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ student_id: currentStudentDbId, document_type: docType })
            });
          } catch(e) {}
        }
      } catch (err) {
        console.error(`Error generating ${docType}:`, err);
      }
    }

    if (generatedCount === 0) {
      alert("Could not generate documents for ZIP export. Please check document selection.");
      return;
    }

    // Generate and download ZIP
    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const zipFilename = `${currentStudent.name.replace(/\s+/g, '_')}_all_documents.zip`;
    
    if (typeof saveAs === 'function') {
      saveAs(zipBlob, zipFilename);
    } else {
      const url = URL.createObjectURL(zipBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = zipFilename;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 2000);
    }
    
    showToast("ZIP download complete!");
  }

  function generatePdfBlob(docType) {
    return new Promise((resolve) => {
      const hiddenFrame = document.createElement('iframe');
      hiddenFrame.style.position = 'fixed';
      hiddenFrame.style.top = '-9999px';
      hiddenFrame.style.left = '-9999px';
      hiddenFrame.style.width = '794px';
      hiddenFrame.style.height = '1123px';
      hiddenFrame.style.opacity = '0';
      hiddenFrame.src = routeMap[docType];
      document.body.appendChild(hiddenFrame);

      let resolved = false;
      const cleanup = () => {
        if (!resolved) {
          resolved = true;
          window.removeEventListener('message', handler);
          if (hiddenFrame.parentNode) document.body.removeChild(hiddenFrame);
        }
      };

      const handler = (event) => {
        if (event.data && event.data.type === 'PDF_BLOB') {
          cleanup();
          resolve(event.data.blob);
        }
      };
      window.addEventListener('message', handler);

      hiddenFrame.onload = () => {
        setTimeout(() => {
          const payload = getPayloadForDoc(docType);
          hiddenFrame.contentWindow.postMessage({ type: 'UPDATE_DATA', data: payload }, '*');
          if (docType === 'certificate') hiddenFrame.contentWindow.postMessage({ type: 'UPDATE_CERT', data: payload }, '*');
          
          setTimeout(() => {
            hiddenFrame.contentWindow.postMessage({ type: 'EXPORT_PDF_BLOB' }, '*');
          }, 600);
        }, 500);
      };

      // Timeout fallback
      setTimeout(() => {
        cleanup();
        resolve(null);
      }, 15000);
    });
  }
</script>
