        <!-- Preview Area - Full Certificate Fit -->
        <div id="previewArea" style="flex: 1; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #F3F4F6;">
          <iframe id="certFrame" style="border: none; position: absolute; top: 0; left: 0; transform-origin: center center;"></iframe>
        </div>

        <!-- 3 Action Buttons at Bottom of Preview -->
        <div id="previewActions" style="display: none; position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 10; background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--erp-border); box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
          <div style="display: flex; gap: 8px;">
            <button onclick="fireAction('download')" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--erp-border); background: var(--erp-primary); color: #fff; transition: var(--erp-transition); font-family: var(--erp-font);">
