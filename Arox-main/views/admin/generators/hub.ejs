        </div>
        <button class="btn-sm">Download</button>
      </div>
      <div class="list-row">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: #111;">Completion Certificate</div>
          <div style="font-size: 10px; color: #6B7280;">Sudheesh Kumar • May 25, 2026 10:31 AM</div>
        </div>
        <button class="btn-sm">Download</button>
      </div>
    </div>
  </div>

</div>

