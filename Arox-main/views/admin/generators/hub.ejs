        <i data-lucide="check-circle-2" style="color: #10B981; width: 24px; height: 24px; flex-shrink: 0;"></i>
        <div>
          <div style="font-size: 13px; font-weight: 700; color: #065F46;">Eligible for Generation</div>
          <div style="font-size: 11px; color: #047857; margin-top: 4px;">Student has met all attendance and payment criteria.</div>
        </div>
      </div>

      <!-- Selected Count -->
      <div id="selectedCountBar" style="display: none; background: var(--erp-primary-light); border: 1px solid var(--erp-primary); border-radius: var(--erp-radius); padding: 12px 16px; text-align: center;">
        <span style="font-size: 13px; font-weight: 600; color: var(--erp-primary);"><span id="selCountText">0</span> document(s) selected</span>
      </div>
    </div>

    <!-- MIDDLE PANEL: Document Hub (30%) -->
    <div class="col-2">
      <div class="hub-panel" style="flex: 1; display: flex; flex-direction: column;">
        <div class="panel-title" style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <i data-lucide="file-box" style="width: 16px;"></i> Document Hub
            <span class="sel-count" id="selBadge" style="display: none;">0</span>
          </div>
          <button type="button" id="btnToggleAll" onclick="toggleSelectAllDocs()" style="background: none; border: none; font-size: 11px; color: var(--erp-primary); cursor: pointer; font-weight: 600; text-decoration: underline;">Select All</button>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 8px; flex: 1;">
          
          <div class="doc-list-item" data-doc="offerletter" onclick="toggleDoc(this, 'offerletter')">
