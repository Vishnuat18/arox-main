            <div class="doc-icon-wrap"><i data-lucide="file-text" style="width: 20px;"></i></div>
            <div class="doc-info">
              <div class="doc-title">Offer Letter</div>
              <div class="doc-status"><i data-lucide="check" style="width: 10px; color: #10B981;"></i> Ready</div>
            </div>
          </div>

          <div class="doc-list-item" data-doc="certificate" onclick="toggleDoc(this, 'certificate')">
            <div class="check-indicator"></div>
            <div class="doc-icon-wrap"><i data-lucide="badge-check" style="width: 20px;"></i></div>
            <div class="doc-info">
              <div class="doc-title">Completion Certificate</div>
              <div class="doc-status"><i data-lucide="check" style="width: 10px; color: #10B981;"></i> Ready</div>
            </div>
          </div>

          <div class="doc-list-item" data-doc="attendance" onclick="toggleDoc(this, 'attendance')">
            <div class="check-indicator"></div>
            <div class="doc-icon-wrap"><i data-lucide="calendar-check" style="width: 20px;"></i></div>
            <div class="doc-info">
              <div class="doc-title">Attendance Certificate</div>
              <div class="doc-status"><i data-lucide="check" style="width: 10px; color: #10B981;"></i> Ready</div>
            </div>
          </div>

          <div class="doc-list-item" data-doc="project" onclick="toggleDoc(this, 'project')">
            <div class="check-indicator"></div>
            <div class="doc-icon-wrap"><i data-lucide="folder-git-2" style="width: 20px;"></i></div>
            <div class="doc-info">
              <div class="doc-title">Project Certificate</div>
              <div class="doc-status"><i data-lucide="check" style="width: 10px; color: #10B981;"></i> Ready</div>
            </div>
          </div>

        </div>

        <button class="btn-primary" style="width: 100%; padding: 12px; border-radius: 6px; font-size: 12px; font-weight: 600; margin-top: 16px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;" onclick="downloadSelectedZip()">
          <i data-lucide="download" style="width: 14px;"></i> Download Selected as ZIP
        </button>
      </div>
    </div>

    <!-- RIGHT PANEL: Live Preview (45%) -->
    <div class="col-3">
      <div class="sandbox-container">
        
        <div class="sandbox-toolbar">
          <button onclick="zoomPreview(-0.1)"><i data-lucide="minus" style="width: 14px;"></i></button>
          <span style="font-size: 11px; font-weight: 600;" id="zoomVal">100%</span>
          <button onclick="zoomPreview(0.1)"><i data-lucide="plus" style="width: 14px;"></i></button>
          <div style="width: 1px; height: 16px; background: #E5E7EB;"></div>
          <button onclick="zoomPreview(0)"><i data-lucide="rotate-cw" style="width: 14px;"></i></button>
          <button onclick="openFullscreenPreview()"><i data-lucide="maximize" style="width: 14px;"></i></button>
        </div>

        <!-- Overlay when no doc selected -->
        <div id="overlay" style="position: absolute; inset: 0; top: 38px; background: rgba(255,255,255,0.9); z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <i data-lucide="file-search" style="width: 32px; height: 32px; color: #9CA3AF; margin-bottom: 12px;"></i>
          <div style="font-size: 13px; font-weight: 600; color: #4B5563;">Select a document to preview</div>
          <div style="font-size: 11px; color: #9CA3AF; margin-top: 4px;">Click a document from the hub to preview</div>
        </div>

        <!-- Preview Area - Direct Certificate View -->
        <div id="previewArea" style="flex: 1; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #ffffff;">
          <iframe id="certFrame" style="border: none; position: absolute; top: 0; left: 0; transform-origin: center center;"></iframe>
        </div>
      </div>
    </div>
    
  </div>

  <!-- STICKY ACTION BAR -->
  <div class="action-bar">
    <button class="primary" onclick="fireAction('generate')"><i data-lucide="zap" style="width: 16px;"></i> Generate</button>
    <div style="width: 1px; height: 24px; background: #E5E7EB; margin: 0 8px;"></div>
    <button onclick="fireAction('download')"><i data-lucide="download" style="width: 16px;"></i> Download</button>
