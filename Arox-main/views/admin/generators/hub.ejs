            </button>
            <button onclick="openFullscreenPreview()" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--erp-border); background: var(--erp-bg); color: var(--erp-text-primary); transition: var(--erp-transition); font-family: var(--erp-font);">
              <i data-lucide="maximize" style="width: 14px; height: 14px;"></i> Fullscreen
            </button>
            <button onclick="fireAction('save')" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--erp-border); background: var(--erp-bg); color: var(--erp-text-primary); transition: var(--erp-transition); font-family: var(--erp-font);">
              <i data-lucide="folder-input" style="width: 14px; height: 14px;"></i> Save to Portal
            </button>
          </div>
        </div>
      </div>
    </div>
    
  </div>

  <!-- STICKY ACTION BAR -->
  <div class="action-bar">
    <button class="primary" onclick="fireAction('generate')"><i data-lucide="zap" style="width: 16px;"></i> Generate</button>
