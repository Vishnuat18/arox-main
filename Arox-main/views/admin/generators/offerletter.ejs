<div class="erp-h1">Offer Letter Generator</div>

<div class="erp-grid-2">
  
  <!-- Left Side: Control Panel -->
  <div class="erp-card" style="height: calc(100vh - 200px); overflow-y: auto;">
    <h3 class="erp-h3">Offer Details</h3>
    
    <div id="erpFormFields">
      <div class="erp-form-group">
        <label class="erp-label">Candidate Name</label>
        <input type="text" id="candidateName" class="erp-input" value="S. Kavin">
      </div>
      <div class="erp-form-group">
        <label class="erp-label">Address / College</label>
        <textarea id="candidateAddress" class="erp-input" rows="2">KSR College of Engineering,
Tiruchengode.</textarea>
      </div>
      <div class="erp-form-group">
        <label class="erp-label">Role Title</label>
        <input type="text" id="roleTitle" class="erp-input" value="Data Science & AI Intern">
      </div>
      <div class="erp-form-group">
        <label class="erp-label">Location</label>
        <input type="text" id="location" class="erp-input" value="Salem">
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="erp-form-group">
          <label class="erp-label">Start Date</label>
          <input type="date" id="startDate" class="erp-input">
        </div>
        <div class="erp-form-group">
          <label class="erp-label">End Date</label>
          <input type="date" id="endDate" class="erp-input">
        </div>
      </div>
      <div class="erp-form-group">
        <label class="erp-label">Stipend Amount</label>
        <input type="text" id="stipendAmount" class="erp-input" value="₹5,000 – ₹8,000 per month (Performance Based)">
      </div>
      <div class="erp-form-group">
        <label class="erp-label">Signatory Name</label>
        <input type="text" id="signatoryName" class="erp-input" value="R. Kavitha">
      </div>
    </div>

    <button id="btnExportPDF" class="erp-btn erp-btn-primary" style="width: 100%; justify-content: center; margin-top: 16px;">
      <i data-lucide="download"></i> Generate PDF
    </button>
  </div>

  <!-- Right Side: Preview -->
  <div class="erp-card" style="padding: 0; overflow: hidden; background: var(--erp-bg-secondary); border: var(--erp-border-width) solid var(--erp-border); display: flex; align-items: center; justify-content: center; height: calc(100vh - 200px);">
    <iframe id="certFrame" src="/offerletter/index.html" style="width: 100%; height: 100%; border: none;"></iframe>
  </div>
</div>

<script>
  const frame = document.getElementById('certFrame');
  
  function updatePreview() {
    if (!frame.contentWindow) return;
    
    const data = {};
    document.querySelectorAll('#erpFormFields input, #erpFormFields textarea, #erpFormFields select').forEach(el => {
      data[el.id] = el.type === 'checkbox' ? el.checked : el.value;
    });
    
    frame.contentWindow.postMessage({ type: 'UPDATE_DATA', data }, '*');
  }

  document.getElementById('erpFormFields').addEventListener('input', updatePreview);
  
  document.getElementById('btnExportPDF').addEventListener('click', () => {
    frame.contentWindow.postMessage({ type: 'EXPORT_PDF' }, '*');
  });

  frame.onload = () => {
    setTimeout(updatePreview, 500);
  };
</script>
