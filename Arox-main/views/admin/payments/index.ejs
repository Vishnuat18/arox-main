<div class="animate-fade-slide-up">
  <div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <div class="search-input-wrapper">
        <span class="search-icon"><i data-lucide="search"></i></span>
        <input type="text" class="form-input" placeholder="Search Transaction ID, Registration ID..." data-table-search="payments-table">
      </div>
      
      <div style="display: flex; gap: 12px;">
        <button class="btn btn-ghost" title="Export to CSV">⬇️ Export</button>
      </div>
    </div>

    <div style="overflow-x: auto;">
      <table class="data-table" id="payments-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Transaction ID</th>
            <th>Registration / Student</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (payments && payments.length > 0) { %>
            <% payments.forEach(p => { %>
              <tr>
                <td>
                  <div style="font-weight: 500;"><%= new Date(p.created_at).toLocaleDateString() %></div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(p.created_at).toLocaleTimeString() %></div>
                </td>
                <td style="font-family: monospace; font-size: 0.9rem; color: var(--primary); font-weight: 600;">
                  <%= p.transaction_id || p.id %>
                </td>
                <td>
                  <div style="font-family: monospace; font-size: 0.85rem;"><%= p.registration_id %></div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);"><%= p.first_name %> <%= p.last_name %></div>
                </td>
                <td style="font-weight: 700;">
                  ₹<%= p.amount.toLocaleString('en-IN') %>
                </td>
                <td>
                  <span style="text-transform: capitalize; font-size: 0.85rem;"><%= p.payment_method %></span>
                </td>
                <td>
                  <% if (p.status === 'completed') { %>
                    <span class="status-badge status-active">Completed</span>
                  <% } else if (p.status === 'failed') { %>
                    <span class="status-badge status-error">Failed</span>
                  <% } else { %>
                    <span class="status-badge status-pending"><%= p.status %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                <div style="font-size: 2rem; margin-bottom: 8px;"><i data-lucide="credit-card"></i></div>
                No payment records found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
