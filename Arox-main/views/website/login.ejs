<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - AROX Tech ERP & Portals</title>
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --auth-bg: #07090e;
      --auth-card: #0f121d;
      --auth-card-border: rgba(255, 255, 255, 0.08);
      --auth-text: #f8fafc;
      --auth-muted: #94a3b8;
      --auth-primary: #2563eb;
      --auth-primary-hover: #1d4ed8;
      --auth-glow: rgba(37, 99, 235, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
      background-color: var(--auth-bg);
      color: var(--auth-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .auth-container {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 100vh;
      width: 100%;
      position: relative;
    }

    @media (min-width: 1024px) {
      .auth-container {
        grid-template-columns: 1.1fr 1fr;
      }
    }

    /* Left Brand & Showcase Pane */
    .auth-left-pane {
      display: none;
      position: relative;
      background: radial-gradient(circle at 10% 20%, rgba(30, 58, 138, 0.25), transparent 50%),
                  radial-gradient(circle at 90% 80%, rgba(15, 23, 42, 0.8), #07090e);
      border-right: 1px solid var(--auth-card-border);
      padding: 4rem 3.5rem;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    @media (min-width: 1024px) {
      .auth-left-pane {
        display: flex;
      }
    }

    .auth-brand {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .auth-brand-logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: #ffffff;
    }

    .auth-brand-logo img {
      height: 44px;
      width: auto;
      object-fit: contain;
    }

    .auth-showcase {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 520px;
    }

    .showcase-header h2 {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.025em;
      background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.75rem;
    }

    .showcase-header p {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--auth-muted);
    }

    .portal-badges {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.85rem;
      margin-top: 0.5rem;
    }

    .portal-card {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.15rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(12px);
      transition: all 0.25s ease;
    }

    .portal-card:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(37, 99, 235, 0.35);
      transform: translateY(-2px);
    }

    .portal-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(37, 99, 235, 0.15);
      color: #60a5fa;
      flex-shrink: 0;
    }

    .portal-info h3 {
      font-size: 0.95rem;
      font-weight: 650;
      color: #ffffff;
      margin-bottom: 0.2rem;
    }

    .portal-info p {
      font-size: 0.825rem;
      color: var(--auth-muted);
      line-height: 1.45;
    }

    .auth-quote-wrap {
      position: relative;
      z-index: 10;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1.5rem;
    }

    .auth-quote {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #cbd5e1;
      font-style: italic;
      margin-bottom: 0.5rem;
    }

    .auth-author {
      font-size: 0.825rem;
      font-weight: 600;
      color: #60a5fa;
    }

    /* Right Form Pane */
    .auth-right-pane {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem 2rem;
      min-height: 100vh;
      overflow-y: auto;
      background: #0b0d14;
    }

    .back-home-btn {
      position: absolute;
      top: 1.75rem;
      left: 1.75rem;
      z-index: 20;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--auth-muted);
      text-decoration: none;
      padding: 0.5rem 0.875rem;
      border-radius: 8px;
      border: 1px solid var(--auth-card-border);
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(8px);
      transition: all 0.2s ease;
    }

    .back-home-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.15);
    }

    .auth-card-inner {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 420px;
      margin: auto 0;
    }

    .mobile-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    @media (min-width: 1024px) {
      .mobile-logo {
        display: none;
      }
    }

    .auth-header {
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .auth-title {
      font-size: 1.75rem;
      font-weight: 750;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .auth-subtitle {
      font-size: 0.9rem;
      color: var(--auth-muted);
    }

    /* 3 Role Switcher */
    .role-switcher {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--auth-card-border);
      border-radius: 12px;
      padding: 4px;
      gap: 4px;
      margin-bottom: 1.5rem;
    }

    .role-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 8px;
      border: 1px solid transparent;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 550;
      color: var(--auth-muted);
      background: transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }

    .role-btn:hover:not(.active) {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
    }

    .role-btn.active {
      background: var(--auth-primary);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.35);
    }

    /* Demo Helper Pills */
    .demo-credentials-box {
      margin-bottom: 1.25rem;
      padding: 0.75rem 0.9rem;
      border-radius: 10px;
      background: rgba(37, 99, 235, 0.06);
      border: 1px dashed rgba(37, 99, 235, 0.3);
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .demo-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #60a5fa;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .demo-fill-btn {
      font-size: 0.75rem;
      color: #93c5fd;
      background: none;
      border: none;
      cursor: pointer;
      text-decoration: underline;
      font-weight: 600;
      padding: 0;
    }

    .demo-fill-btn:hover {
      color: #ffffff;
    }

    .demo-details {
      font-size: 0.8rem;
      color: #cbd5e1;
      font-family: var(--font-mono, monospace);
    }

    /* Form Fields */
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      text-align: left;
    }

    .form-label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .form-label {
      font-size: 0.8125rem;
      font-weight: 550;
      color: #cbd5e1;
    }

    .forgot-link {
      font-size: 0.8125rem;
      font-weight: 500;
      color: #60a5fa;
      text-decoration: none;
      transition: color 0.2s;
    }

    .forgot-link:hover {
      color: #93c5fd;
      text-decoration: underline;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon-left {
      position: absolute;
      left: 12px;
      color: var(--auth-muted);
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .auth-input {
      width: 100%;
      height: 44px;
      padding: 0 14px 0 40px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--auth-card-border);
      border-radius: 10px;
      color: #ffffff;
      font-size: 0.875rem;
      font-family: inherit;
      outline: none;
      transition: all 0.2s ease;
    }

    .auth-input:focus {
      border-color: var(--auth-primary);
      background: rgba(37, 99, 235, 0.05);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    }

    .input-btn-right {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      color: var(--auth-muted);
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
      transition: color 0.2s;
    }

    .input-btn-right:hover {
      color: #ffffff;
    }

    .remember-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      color: var(--auth-muted);
      cursor: pointer;
      user-select: none;
    }

    .remember-row input {
      accent-color: var(--auth-primary);
      width: 15px;
      height: 15px;
      border-radius: 4px;
    }

    .auth-error {
      display: none;
      background: rgba(220, 38, 38, 0.12);
      border: 1px solid rgba(220, 38, 38, 0.35);
      color: #f87171;
      padding: 0.65rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 500;
    }

    .auth-submit-btn {
      height: 46px;
      width: 100%;
      border-radius: 10px;
      border: none;
      background: var(--auth-primary);
      color: #ffffff;
      font-size: 0.925rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
      margin-top: 0.35rem;
    }

    .auth-submit-btn:hover:not(:disabled) {
      background: var(--auth-primary-hover);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
      transform: translateY(-1px);
    }

    .auth-submit-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .auth-switch-link {
      margin-top: 1.5rem;
      font-size: 0.875rem;
      color: var(--auth-muted);
      text-align: center;
    }

    .auth-switch-link a {
      color: #60a5fa;
      font-weight: 600;
      text-decoration: none;
    }

    .auth-switch-link a:hover {
      text-decoration: underline;
    }

    .auth-footer {
      margin-top: 2rem;
      font-size: 0.775rem;
      color: #64748b;
      text-align: center;
      line-height: 1.5;
    }

    .auth-footer a {
      color: #94a3b8;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    
    <!-- Left Pane: Branding & Portal Showcase (No Animation) -->
    <div class="auth-left-pane">
      <div class="auth-brand">
        <a href="/" class="auth-brand-logo">
          <img src="/public/assets/logo/logo-dark.png" alt="AROX" onerror="this.src='/assets/logo/logo-dark.png'" />
        </a>
      </div>

      <div class="auth-showcase">
        <div class="showcase-header">
          <h2>Unified ERP & Learning Ecosystem</h2>
          <p>Seamlessly manage your academic journey, organizational workflows, certifications, and payments all in one high-fidelity environment.</p>
        </div>

        <div class="portal-badges">
          <div class="portal-card">
            <div class="portal-icon">
              <i data-lucide="graduation-cap" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="portal-info">
              <h3>Student Portal</h3>
              <p>Access enrolled courses, track daily attendance, view payment balance, and download verified certificates.</p>
            </div>
          </div>

          <div class="portal-card">
            <div class="portal-icon" style="background: rgba(147, 51, 234, 0.15); color: #c084fc;">
              <i data-lucide="shield" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="portal-info">
              <h3>Admin ERP Suite</h3>
              <p>Comprehensive registration management, automated offer letter generators, and financial analytics.</p>
            </div>
          </div>

          <div class="portal-card">
            <div class="portal-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
              <i data-lucide="briefcase" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="portal-info">
              <h3>Employee & Trainer Portal</h3>
              <p>Conduct batches, evaluate submissions, mark class attendance, and issue progress reports.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="auth-quote-wrap">
        <p class="auth-quote">&ldquo;AROX ERP provides a world-class training experience with automated certifications and instant record verification.&rdquo;</p>
        <span class="auth-author">AROX Engineering & Academic Operations</span>
      </div>
    </div>

    <!-- Right Pane: Direct Authentication Form -->
    <div class="auth-right-pane">
      <a href="/" class="back-home-btn" aria-label="Back to Home">
        <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
        <span>Home</span>
      </a>

      <div class="auth-card-inner">
        <!-- Mobile Logo -->
        <div class="mobile-logo">
          <img src="/public/assets/logo/logo-dark.png" alt="AROX" style="height: 38px;" onerror="this.src='/assets/logo/logo-dark.png'" />
        </div>

        <div class="auth-header">
          <h1 class="auth-title" id="loginTitle">Student Portal</h1>
          <p class="auth-subtitle" id="loginSubtitle">Sign in to access your courses, attendance, and certificates.</p>
        </div>

        <!-- 3 Role Switcher -->
        <div class="role-switcher" role="tablist" aria-label="Select Role">
          <button type="button" class="role-btn active" data-role="student" role="tab" aria-selected="true" onclick="setRole('student')">
            <i data-lucide="graduation-cap" style="width: 14px; height: 14px;"></i>
            <span>Student</span>
          </button>
          <button type="button" class="role-btn" data-role="admin" role="tab" aria-selected="false" onclick="setRole('admin')">
            <i data-lucide="shield" style="width: 14px; height: 14px;"></i>
            <span>Admin</span>
          </button>
          <button type="button" class="role-btn" data-role="employee" role="tab" aria-selected="false" onclick="setRole('employee')">
            <i data-lucide="briefcase" style="width: 14px; height: 14px;"></i>
            <span>Employee</span>
          </button>
        </div>

        <!-- Quick Demo Autofill Box -->
        <div class="demo-credentials-box" id="demoBox">
          <div class="demo-title">
            <span id="demoLabel">Student Demo Credentials</span>
            <button type="button" class="demo-fill-btn" onclick="fillDemoCredentials()">Auto-Fill</button>
          </div>
          <div class="demo-details" id="demoDetails">student@arox.com • student123</div>
        </div>

        <!-- Credentials Form -->
        <form id="loginForm" class="auth-form">
          <input type="hidden" name="role" id="loginRoleInput" value="student">

          <div class="form-group">
            <label class="form-label" id="emailLabel">Student Email</label>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="at-sign" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="email" name="email" id="emailInput" class="auth-input" placeholder="student@arox.com" required autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <div class="form-label-row">
              <label class="form-label">Password</label>
              <a href="#" class="forgot-link">Forgot password?</a>
            </div>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="lock" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="password" name="password" id="password" class="auth-input" placeholder="••••••••" required autocomplete="current-password">
              <button type="button" id="togglePasswordBtn" class="input-btn-right" aria-label="Toggle password">
                <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
              </button>
            </div>
          </div>

          <label class="remember-row">
            <input type="checkbox" name="remember" checked>
            <span>Remember for 30 days</span>
          </label>

          <div id="loginError" class="auth-error"></div>

          <button type="submit" id="loginBtn" class="auth-submit-btn">
            <span id="btnText">Sign In to Student Portal</span>
            <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
          </button>
        </form>

        <div class="auth-switch-link">
          <span id="footerText">Don't have an account? </span>
          <a href="/signup" id="footerLink">Sign Up Now</a>
        </div>

        <p class="auth-footer">
          By signing in, you agree to the 
          <a href="#">Terms of Service</a> and 
          <a href="#">Privacy Policy</a>.
        </p>
      </div>
    </div>

  </div>

  <script>
    const roleConfig = {
      student: {
        title: 'Student Portal',
        subtitle: 'Sign in to access your courses, attendance, and certificates.',
        emailLabel: 'Student Email',
        emailPlaceholder: 'student@arox.com',
        btnText: 'Sign In to Student Portal',
        demoLabel: 'Student Demo Account',
        demoEmail: 'student@arox.com',
        demoPass: 'student123',
        footerText: "Don't have an account?",
        footerLinkText: 'Sign Up Now',
        footerLinkHref: '/signup'
      },
      admin: {
        title: 'Admin ERP Portal',
        subtitle: 'Enter administrator credentials to manage courses, users, and financials.',
        emailLabel: 'Admin Email',
        emailPlaceholder: 'admin@aroxtech.com',
        btnText: 'Sign In to Admin ERP',
        demoLabel: 'Admin Demo Account',
        demoEmail: 'admin@arox.com',
        demoPass: 'admin123',
        footerText: 'Protected Gateway • ',
        footerLinkText: 'Need Access?',
        footerLinkHref: '/signup?role=admin'
      },
      employee: {
        title: 'Employee / Trainer Portal',
        subtitle: 'Sign in to access trainer tools, schedules, and student evaluations.',
        emailLabel: 'Employee Email',
        emailPlaceholder: 'employee@arox.com',
        btnText: 'Sign In to Employee Portal',
        demoLabel: 'Employee Demo Account',
        demoEmail: 'employee@arox.com',
        demoPass: 'employee123',
        footerText: 'Internal Access • ',
        footerLinkText: 'Staff Registration',
        footerLinkHref: '/signup?role=employee'
      }
    };

    let activeRole = 'student';

    function setRole(role) {
      activeRole = role;
      const cfg = roleConfig[role] || roleConfig.student;

      document.querySelectorAll('.role-btn').forEach(btn => {
        const isMatch = btn.dataset.role === role;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      document.getElementById('loginTitle').textContent = cfg.title;
      document.getElementById('loginSubtitle').textContent = cfg.subtitle;
      document.getElementById('emailLabel').textContent = cfg.emailLabel;
      
      const emailInput = document.getElementById('emailInput');
      emailInput.placeholder = cfg.emailPlaceholder;
      
      document.getElementById('loginRoleInput').value = role;
      document.getElementById('btnText').textContent = cfg.btnText;

      document.getElementById('demoLabel').textContent = cfg.demoLabel;
      document.getElementById('demoDetails').textContent = `${cfg.demoEmail} • ${cfg.demoPass}`;

      const footerText = document.getElementById('footerText');
      if (footerText) footerText.textContent = cfg.footerText + ' ';
      const footerLink = document.getElementById('footerLink');
      if (footerLink) {
        footerLink.textContent = cfg.footerLinkText;
        footerLink.href = cfg.footerLinkHref;
      }

      const err = document.getElementById('loginError');
      if (err) err.style.display = 'none';

      lucide.createIcons();
    }

    function fillDemoCredentials() {
      const cfg = roleConfig[activeRole] || roleConfig.student;
      document.getElementById('emailInput').value = cfg.demoEmail;
      document.getElementById('password').value = cfg.demoPass;
    }

    // Toggle Password visibility
    document.getElementById('togglePasswordBtn').addEventListener('click', (e) => {
      const input = document.getElementById('password');
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      e.currentTarget.innerHTML = isPassword 
        ? '<i data-lucide="eye-off" style="width: 16px; height: 16px;"></i>' 
        : '<i data-lucide="eye" style="width: 16px; height: 16px;"></i>';
      lucide.createIcons();
    });

    // Form submission
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const errorDiv = document.getElementById('loginError');
      const btn = document.getElementById('loginBtn');

      errorDiv.style.display = 'none';
      btn.disabled = true;
      btn.innerHTML = '<span>Verifying credentials...</span>';

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Login failed. Please check your credentials.');
        }

        btn.innerHTML = '<span>Success ✓</span>';
        window.location.href = result.redirectUrl || '/student/dashboard';

      } catch (err) {
        errorDiv.textContent = err.message;
        errorDiv.style.display = 'block';
        btn.disabled = false;
        const cfg = roleConfig[activeRole] || roleConfig.student;
        btn.innerHTML = `<span id="btnText">${cfg.btnText}</span><i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>`;
        lucide.createIcons();
      }
    });

    // Initialize icons and check URL query params for initial role
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const roleParam = urlParams.get('role');
      if (roleParam && ['student', 'admin', 'employee'].includes(roleParam)) {
        setRole(roleParam);
      } else {
        setRole('student');
      }
      lucide.createIcons();
    });
  </script>
</body>
</html>