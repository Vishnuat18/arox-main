<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account - AROX Tech ERP & Portals</title>
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --auth-bg: #07090e;
      --auth-card: #0f121d;
      --auth-card-border: rgba(255, 255, 255, 0.08);
      --auth-text: #f8fafc;
      --auth-muted: #94a3b8;
      --auth-primary: #2563eb;
      --auth-primary-hover: #1d4ed8;
      --auth-glow: rgba(37, 99, 235, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
      background-color: var(--auth-bg);
      color: var(--auth-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .auth-container {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 100vh;
      width: 100%;
      position: relative;
    }

    @media (min-width: 1024px) {
      .auth-container {
        grid-template-columns: 1.1fr 1fr;
      }
    }

    /* Left Brand & Showcase Pane (No animation) */
    .auth-left-pane {
      display: none;
      position: relative;
      background: radial-gradient(circle at 10% 20%, rgba(30, 58, 138, 0.25), transparent 50%),
                  radial-gradient(circle at 90% 80%, rgba(15, 23, 42, 0.8), #07090e);
      border-right: 1px solid var(--auth-card-border);
      padding: 4rem 3.5rem;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    @media (min-width: 1024px) {
      .auth-left-pane {
        display: flex;
      }
    }

    .auth-brand {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .auth-brand-logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: #ffffff;
    }

    .auth-brand-logo img {
      height: 44px;
      width: auto;
      object-fit: contain;
    }

    .auth-showcase {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 520px;
    }

    .showcase-header h2 {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.025em;
      background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.75rem;
    }

    .showcase-header p {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--auth-muted);
    }

    .portal-badges {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.85rem;
      margin-top: 0.5rem;
    }

    .portal-card {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.15rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(12px);
      transition: all 0.25s ease;
    }

    .portal-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(37, 99, 235, 0.15);
      color: #60a5fa;
      flex-shrink: 0;
    }

    .portal-info h3 {
      font-size: 0.95rem;
      font-weight: 650;
      color: #ffffff;
      margin-bottom: 0.2rem;
    }

    .portal-info p {
      font-size: 0.825rem;
      color: var(--auth-muted);
      line-height: 1.45;
    }

    .auth-quote-wrap {
      position: relative;
      z-index: 10;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1.5rem;
    }

    .auth-quote {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #cbd5e1;
      font-style: italic;
      margin-bottom: 0.5rem;
    }

    .auth-author {
      font-size: 0.825rem;
      font-weight: 600;
      color: #60a5fa;
    }

    /* Right Form Pane */
    .auth-right-pane {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem 2rem;
      min-height: 100vh;
      overflow-y: auto;
      background: #0b0d14;
    }

    .back-home-btn {
      position: absolute;
      top: 1.75rem;
      left: 1.75rem;
      z-index: 20;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--auth-muted);
      text-decoration: none;
      padding: 0.5rem 0.875rem;
      border-radius: 8px;
      border: 1px solid var(--auth-card-border);
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(8px);
      transition: all 0.2s ease;
    }

    .back-home-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.15);
    }

    .auth-card-inner {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 440px;
      margin: auto 0;
    }

    .mobile-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    @media (min-width: 1024px) {
      .mobile-logo {
        display: none;
      }
    }

    .auth-header {
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .auth-title {
      font-size: 1.75rem;
      font-weight: 750;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .auth-subtitle {
      font-size: 0.9rem;
      color: var(--auth-muted);
    }

    /* Account Type Switcher */
    .role-switcher {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--auth-card-border);
      border-radius: 12px;
      padding: 4px;
      gap: 4px;
      margin-bottom: 1.5rem;
    }

    .role-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 8px;
      border: 1px solid transparent;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 550;
      color: var(--auth-muted);
      background: transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }

    .role-btn:hover:not(.active) {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
    }

    .role-btn.active {
      background: var(--auth-primary);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.35);
    }

    /* Form Fields */
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 1.05rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      text-align: left;
    }

    .form-label {
      font-size: 0.8125rem;
      font-weight: 550;
      color: #cbd5e1;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon-left {
      position: absolute;
      left: 12px;
      color: var(--auth-muted);
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .auth-input {
      width: 100%;
      height: 44px;
      padding: 0 14px 0 40px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--auth-card-border);
      border-radius: 10px;
      color: #ffffff;
      font-size: 0.875rem;
      font-family: inherit;
      outline: none;
      transition: all 0.2s ease;
    }

    .auth-input:focus {
      border-color: var(--auth-primary);
      background: rgba(37, 99, 235, 0.05);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    }

    .auth-error {
      display: none;
      background: rgba(220, 38, 38, 0.12);
      border: 1px solid rgba(220, 38, 38, 0.35);
      color: #f87171;
      padding: 0.65rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 500;
    }

    .auth-submit-btn {
      height: 46px;
      width: 100%;
      border-radius: 10px;
      border: none;
      background: var(--auth-primary);
      color: #ffffff;
      font-size: 0.925rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
      margin-top: 0.5rem;
    }

    .auth-submit-btn:hover:not(:disabled) {
      background: var(--auth-primary-hover);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
      transform: translateY(-1px);
    }

    .auth-submit-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .auth-switch-link {
      margin-top: 1.5rem;
      font-size: 0.875rem;
      color: var(--auth-muted);
      text-align: center;
    }

    .auth-switch-link a {
      color: #60a5fa;
      font-weight: 600;
      text-decoration: none;
    }

    .auth-switch-link a:hover {
      text-decoration: underline;
    }

    .auth-footer {
      margin-top: 2rem;
      font-size: 0.775rem;
      color: #64748b;
      text-align: center;
      line-height: 1.5;
    }

    .auth-footer a {
      color: #94a3b8;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    
    <!-- Left Pane: Branding & Showcase (No Animation) -->
    <div class="auth-left-pane">
      <div class="auth-brand">
        <a href="/" class="auth-brand-logo">
          <img src="/public/assets/logo/logo-dark.png" alt="AROX" onerror="this.src='/assets/logo/logo-dark.png'" />
        </a>
      </div>

      <div class="auth-showcase">
        <div class="showcase-header">
          <h2>Create Your AROX Account</h2>
          <p>Join thousands of students and educators utilizing our state-of-the-art ERP management platform.</p>
        </div>

        <div class="portal-badges">
          <div class="portal-card">
            <div class="portal-icon">
              <i data-lucide="award" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="portal-info">
              <h3>Verified Credentials</h3>
              <p>Receive cryptographically verified certificates and automated offer letters with QR verification.</p>
            </div>
          </div>

          <div class="portal-card">
            <div class="portal-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
              <i data-lucide="layers" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="portal-info">
              <h3>Industry Programs</h3>
              <p>Hands-on internships, comprehensive training curriculums, and live mentor project reviews.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="auth-quote-wrap">
        <p class="auth-quote">&ldquo;Accelerate your career with industry-recognized certifications and real-world project portfolios.&rdquo;</p>
        <span class="auth-author">AROX Academic Admissions</span>
      </div>
    </div>

    <!-- Right Pane: Registration Form -->
    <div class="auth-right-pane">
      <a href="/" class="back-home-btn" aria-label="Back to Home">
        <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
        <span>Home</span>
      </a>

      <div class="auth-card-inner">
        <div class="mobile-logo">
          <img src="/public/assets/logo/logo-dark.png" alt="AROX" style="height: 38px;" onerror="this.src='/assets/logo/logo-dark.png'" />
        </div>

        <div class="auth-header">
          <h1 class="auth-title">Create Account</h1>
          <p class="auth-subtitle">Register to access your portal and start learning.</p>
        </div>

        <!-- Role Switcher: Student vs Employee -->
        <div class="role-switcher" role="tablist">
          <button type="button" class="role-btn active" data-role="student" onclick="setSignupRole('student')">
            <i data-lucide="graduation-cap" style="width: 14px; height: 14px;"></i>
            <span>Student</span>
          </button>
          <button type="button" class="role-btn" data-role="employee" onclick="setSignupRole('employee')">
            <i data-lucide="briefcase" style="width: 14px; height: 14px;"></i>
            <span>Employee / Staff</span>
          </button>
        </div>

        <!-- Registration Form -->
        <form id="signupForm" class="auth-form">
          <input type="hidden" name="role" id="signupRoleInput" value="student">

          <div class="form-group">
            <label class="form-label">Full Name</label>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="user" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="text" name="name" id="nameInput" class="auth-input" placeholder="e.g. Alex Morgan" required autocomplete="name">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Email Address</label>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="at-sign" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="email" name="email" id="emailInput" class="auth-input" placeholder="alex@example.com" required autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Phone / WhatsApp Number</label>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="phone" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="tel" name="phone" id="phoneInput" class="auth-input" placeholder="+91 98765 43210" autocomplete="tel">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Password</label>
            <div class="input-wrapper">
              <span class="input-icon-left">
                <i data-lucide="lock" style="width: 16px; height: 16px;"></i>
              </span>
              <input type="password" name="password" id="password" class="auth-input" placeholder="Minimum 6 characters" required minlength="6" autocomplete="new-password">
            </div>
          </div>

          <div id="signupError" class="auth-error"></div>

          <button type="submit" id="signupBtn" class="auth-submit-btn">
            <span id="signupBtnText">Create Student Account</span>
            <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
          </button>
        </form>

        <div class="auth-switch-link">
          <span>Already have an account? </span>
          <a href="/login">Sign In</a>
        </div>

        <p class="auth-footer">
          By signing up, you agree to our 
          <a href="#">Terms of Service</a> and 
          <a href="#">Privacy Policy</a>.
        </p>
      </div>
    </div>

  </div>

  <script>
    let activeSignupRole = 'student';

    function setSignupRole(role) {
      activeSignupRole = role;
      document.querySelectorAll('.role-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.role === role);
      });
      document.getElementById('signupRoleInput').value = role;
      const btnText = document.getElementById('signupBtnText');
      if (btnText) {
        btnText.textContent = role === 'employee' ? 'Create Employee Account' : 'Create Student Account';
      }
      const err = document.getElementById('signupError');
      if (err) err.style.display = 'none';
      lucide.createIcons();
    }

    document.getElementById('signupForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const errorDiv = document.getElementById('signupError');
      const btn = document.getElementById('signupBtn');

      errorDiv.style.display = 'none';
      btn.disabled = true;
      btn.innerHTML = '<span>Creating account...</span>';

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Registration failed. Please try again.');
        }

        btn.innerHTML = '<span>Account Created ✓</span>';
        window.location.href = result.redirectUrl || '/student/dashboard';

      } catch (err) {
        errorDiv.textContent = err.message;
        errorDiv.style.display = 'block';
        btn.disabled = false;
        const btnText = activeSignupRole === 'employee' ? 'Create Employee Account' : 'Create Student Account';
        btn.innerHTML = `<span>${btnText}</span><i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>`;
        lucide.createIcons();
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const roleParam = urlParams.get('role');
      if (roleParam && ['student', 'employee'].includes(roleParam)) {
        setSignupRole(roleParam);
      }
      lucide.createIcons();
    });
  </script>
</body>
</html>
