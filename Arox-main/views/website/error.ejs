<section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 40px 20px;">
  <div class="animate-scale-in">
    <div style="font-size: 6rem; margin-bottom: 16px; opacity: 0.3;">
      <%= typeof code !== 'undefined' && code === 404 ? '<i data-lucide="search"></i>' : '<i data-lucide="alert-triangle"></i>' %>
    </div>
    <h1 style="font-size: 5rem; font-weight: 900; color: var(--primary); margin-bottom: 8px;">
      <%= typeof code !== 'undefined' ? code : 404 %>
    </h1>
    <h2 style="margin-bottom: 12px; font-weight: 600;">
      <%= typeof code !== 'undefined' && code === 404 ? 'Page Not Found' : 'Something Went Wrong' %>
    </h2>
    <p style="color: var(--text-secondary); max-width: 400px; margin: 0 auto 32px;">
      <%= typeof message !== 'undefined' ? message : "The page you're looking for doesn't exist or has been moved." %>
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary btn-lg">← Back to Home</a>
      <a href="/contact" class="btn btn-secondary btn-lg">Contact Support</a>
    </div>
  </div>
</section>
