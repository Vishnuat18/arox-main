<div class="space-y-8 animate-fade-in">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">My Registered Courses</h1>
      <p class="text-sm text-gray-500 mt-1">Access course curriculum, submissions, and attendance logs.</p>
    </div>
  </div>

  <% if (courses && courses.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% courses.forEach(course => { %>
        <div class="card p-6 flex flex-col justify-between hover-card">
          <div>
            <div class="flex justify-between items-start gap-2 mb-4">
              <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-full uppercase tracking-wide
                <%= course.category === 'internship' ? 'bg-purple-100 text-purple-800' : 'bg-emerald-100 text-emerald-800' %>">
                <%= course.category %>
              </span>
              <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-lg uppercase
                <%= course.reg_status === 'active' || course.reg_status === 'confirmed' ? 'bg-emerald-100 text-emerald-800' : 
                    course.reg_status === 'completed' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800' %>">
                <%= course.reg_status %>
              </span>
            </div>

            <h3 class="text-lg font-bold text-gray-800 mb-2 line-clamp-2"><%= course.title %></h3>
            <p class="text-sm text-gray-500 mb-4 line-clamp-3"><%= course.short_description %></p>
            
            <div class="space-y-2 border-t border-gray-100 pt-4 mb-6">
              <div class="flex justify-between text-sm text-gray-600">
                <span class="text-gray-400">Duration:</span>
                <span class="font-medium text-gray-800"><%= course.duration %></span>
              </div>
              <div class="flex justify-between text-sm text-gray-600">
                <span class="text-gray-400">Batch Name:</span>
                <span class="font-medium text-gray-800"><%= course.batch_name || 'N/A' %></span>
              </div>
              <div class="flex justify-between text-sm text-gray-600">
                <span class="text-gray-400">Enrolled On:</span>
                <span class="font-medium text-gray-800"><%= new Date(course.enrolled_at).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
              </div>
            </div>
          </div>

          <div class="w-100">
            <a href="/student/courses/<%= course.registration_id %>" class="btn btn-primary w-full text-center py-2.5 rounded-xl block">
              Access Course Dashboard
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card p-12 text-center text-gray-500 max-w-xl mx-auto mt-12">
      <div class="text-5xl mb-4 flex justify-center"><i data-lucide="book-open" style="width: 48px; height: 48px;"></i></div>
      <p class="font-bold text-lg">No enrolled courses yet</p>
      <p class="text-sm text-gray-400 mt-2">Browse our high-quality internship programs and training paths to register and kickstart your technology career.</p>
      <div class="mt-6 flex justify-center gap-4">
        <a href="/internships" class="btn btn-primary px-6 py-2.5 rounded-lg">Internships</a>
        <a href="/training" class="btn btn-outline px-6 py-2.5 rounded-lg">Training Programs</a>
      </div>
    </div>
  <% } %>
</div>
