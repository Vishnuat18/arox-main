<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>My Enrolled Programs</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500;">
    <i data-lucide="book-marked" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i>
    Curriculum, Daily Logs & Credentials
  </div>
</div>

<% if (courses && courses.length > 0) { %>
  <div class="erp-grid-3" style="align-items: stretch;">
    <% courses.forEach(course => { %>
      <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 20px;">
        <div>
          <!-- Type and Status Badges -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #F1F5F9; color: #000000; padding: 3px 8px; border-radius: 4px; border: 1px solid #E2E8F0;">
              <%= course.category || 'Program' %>
            </span>
            <span style="font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 99px; <%= (course.reg_status === 'active' || course.reg_status === 'confirmed') ? 'background: #000000; color: #FFFFFF;' : 'background: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1;' %>">
              <%= (course.reg_status === 'active' || course.reg_status === 'confirmed') ? 'Active' : (course.reg_status || 'Enrolled') %>
            </span>
          </div>

          <!-- Course Title & Description -->
          <h3 class="erp-h3" style="margin: 0 0 8px 0; color: #000000; font-size: 16px; line-height: 1.4;">
            <%= course.title %>
          </h3>
          <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748B; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            <%= course.short_description || course.description || 'Access course syllabus, projects, and live verification dashboard.' %>
          </p>

          <!-- Metadata Section -->
          <div style="padding-top: 14px; border-top: 1px solid #E2E8F0; display: flex; flex-direction: column; gap: 8px; font-size: 12.5px;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: #64748B;">Duration:</span>
              <span style="font-weight: 600; color: #000000;"><%= course.duration || 'Flexible' %></span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: #64748B;">Batch:</span>
              <span style="font-weight: 600; color: #000000;"><%= course.batch_name || 'General' %></span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: #64748B;">Enrolled On:</span>
              <span style="font-weight: 600; color: #000000;">
                <%= new Date(course.enrolled_at || course.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </span>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <a href="/student/courses/<%= course.registration_id %>" class="erp-btn erp-btn-primary" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 600; background: #000000; color: #FFFFFF; border-radius: 8px; text-align: center; text-decoration: none;">
          Open Program Dashboard <i data-lucide="arrow-right" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i>
        </a>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 48px; text-align: center; max-width: 540px; margin: 40px auto;">
    <div style="font-size: 32px; color: #94A3B8; margin-bottom: 12px;">
      <i data-lucide="book-open"></i>
    </div>
    <h3 class="erp-h3" style="color: #000000; margin-bottom: 8px;">No Enrolled Programs Yet</h3>
    <p style="font-size: 13px; color: #64748B; margin-bottom: 24px; line-height: 1.5;">
      Explore our certified internship tracks and technical training curricula to kickstart your career.
    </p>
    <div style="display: flex; justify-content: center; gap: 12px;">
      <a href="/internships" class="erp-btn erp-btn-primary" style="background: #000000; color: #FFFFFF; padding: 9px 18px;">
        Browse Internships
      </a>
      <a href="/training" class="erp-btn erp-btn-secondary" style="border: 1px solid #CBD5E1; color: #000000; padding: 9px 18px;">
        Browse Trainings
      </a>
    </div>
  </div>
<% } %>
