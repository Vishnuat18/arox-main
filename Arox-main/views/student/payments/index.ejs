<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Payments & Dues</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500;">
    <i data-lucide="shield-check" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i>
    Official AROX UPI & Bank Transfer Portal
  </div>
</div>

<!-- Financial Summary Cards -->
<% 
  let grandTotal = 0;
  let grandPaid = 0;
  let grandPending = 0;
  if (registrations && registrations.length > 0) {
    registrations.forEach(r => {
      grandTotal += Number(r.total_amount || 0);
      grandPaid += Number(r.paid_amount || 0);
      grandPending += Number(r.balance_amount || 0);
    });
  }
%>
<div class="erp-grid-3" style="margin-bottom: 28px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="book-open"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Fee Owed</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= grandTotal.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 8px; color: #64748B; font-size: 12px;">Enrolled programs</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Paid & Verified</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= grandPaid.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 8px; color: #000000; font-weight: 600; font-size: 12px;">
      <i data-lucide="shield" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i> Cleared Dues
    </div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Outstanding Balance</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= grandPending.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 8px; color: #64748B; font-size: 12px;">
      <%= grandPending > 0 ? 'Due for verification' : 'All dues settled' %>
    </div>
  </div>
</div>

<!-- Main 2-Column Balanced Layout (No nested scrolling) -->
<div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; align-items: flex-start;" class="payments-grid-wrapper">
  
  <!-- Left: Transaction & Verification History -->
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid #E2E8F0;">
      <h3 class="erp-h3" style="margin: 0; color: #000000;">Payment & Verification History</h3>
      <p style="margin: 4px 0 0 0; font-size: 13px; color: #64748B;">Records of submitted payments and verification statuses.</p>
    </div>

    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="color: #000000;">Date & ID</th>
            <th style="color: #000000;">Course</th>
            <th style="color: #000000;">Method</th>
            <th style="color: #000000;">Amount</th>
            <th style="text-align: center; color: #000000;">Receipt</th>
            <th style="text-align: right; color: #000000;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (payments && payments.length > 0) { %>
            <% payments.forEach(payment => { %>
              <tr>
                <td>
                  <div style="font-weight: 600; font-size: 13px; color: #000000;">
                    <%= new Date(payment.paid_at || payment.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </div>
                  <div class="erp-small" style="font-family: monospace; color: #64748B;"><%= payment.transaction_id || payment.payment_id %></div>
                </td>
                <td>
                  <div style="font-weight: 600; font-size: 13px; color: #000000;"><%= payment.course_title %></div>
                </td>
                <td>
                  <span style="text-transform: uppercase; font-size: 11px; font-weight: 600; background: #F1F5F9; color: #000000; padding: 2px 6px; border-radius: 4px; border: 1px solid #E2E8F0;">
                    <%= payment.payment_method || 'UPI' %>
                  </span>
                </td>
                <td style="font-weight: 700; font-size: 13px; color: #000000;">
                  ₹<%= Number(payment.amount || 0).toLocaleString('en-IN') %>
                </td>
                <td style="text-align: center;">
                  <% if (payment.receipt_path) { %>
                    <a href="<%= payment.receipt_path %>" target="_blank" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; font-weight: 600; color: #000000; border: 1px solid #CBD5E1;">
                      <i data-lucide="file-text" style="width: 12px; height: 12px;"></i> View
                    </a>
                  <% } else { %>
                    <span style="color: #94A3B8; font-size: 12px;">-</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <% if (payment.status === 'completed' || payment.status === 'confirmed') { %>
                    <span style="display: inline-block; padding: 3px 8px; background: #000000; color: #FFFFFF; border-radius: 99px; font-size: 11px; font-weight: 600;">Verified</span>
                  <% } else if (payment.status === 'failed' || payment.status === 'rejected') { %>
                    <span style="display: inline-block; padding: 3px 8px; background: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1; border-radius: 99px; font-size: 11px; font-weight: 600;">Rejected</span>
                  <% } else { %>
                    <span style="display: inline-block; padding: 3px 8px; background: #F1F5F9; color: #000000; border: 1px solid #000000; border-radius: 99px; font-size: 11px; font-weight: 600;">Pending</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align: center; padding: 36px; color: #64748B;">
                <div style="font-size: 20px; margin-bottom: 6px; color: #94A3B8;"><i data-lucide="receipt"></i></div>
                No payment history records found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right: Scan & Pay UPI & Submit Proof Form -->
  <div style="display: flex; flex-direction: column; gap: 20px;">
    
    <!-- QR & Bank Details Card -->
    <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 class="erp-h3" style="margin: 0; color: #000000;">Scan & Pay via UPI</h3>
        <span style="font-size: 11px; font-weight: 600; padding: 3px 8px; background: #000000; color: #FFFFFF; border-radius: 99px;">Official QR</span>
      </div>

      <!-- QR Code Display -->
      <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 12px; padding: 16px; text-align: center; margin-bottom: 16px;">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=aroxtechnologies@icici%26pn=AROX%20TECHNOLOGIES%20PVT%20LTD%26cu=INR" alt="AROX UPI QR Code" style="width: 140px; height: 140px; margin: 0 auto; display: block; border-radius: 8px; border: 1px solid #E2E8F0; background: #FFFFFF;">
        <div style="font-weight: 700; font-size: 13px; color: #000000; margin-top: 10px;">AROX TECHNOLOGIES PVT LTD</div>
        <div style="font-size: 11px; color: #64748B; margin-top: 2px;">Scan with GPay, PhonePe, Paytm, BHIM</div>
      </div>

      <!-- UPI ID Copy Box -->
      <div style="padding: 10px 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <div>
          <div style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748B;">UPI ID</div>
          <div style="font-family: monospace; font-weight: 700; font-size: 13px; color: #000000;">aroxtechnologies@icici</div>
        </div>
        <button type="button" onclick="copyUpiText('aroxtechnologies@icici', this)" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 12px; font-weight: 600; color: #000000; border: 1px solid #CBD5E1;">
          <i data-lucide="copy" style="width: 12px; height: 12px;"></i> Copy
        </button>
      </div>

      <!-- Bank Transfer Details (Collapsible/Clean) -->
      <div style="padding: 12px 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; font-size: 12px;">
        <div style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748B; margin-bottom: 6px;">Bank Transfer (NEFT / IMPS)</div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
          <span style="color: #64748B;">Account:</span>
          <span style="font-family: monospace; font-weight: 600; color: #000000;">000905034821</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
          <span style="color: #64748B;">IFSC Code:</span>
          <span style="font-family: monospace; font-weight: 600; color: #000000;">ICIC0000009</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: #64748B;">Bank & Branch:</span>
          <span style="font-weight: 600; color: #000000;">ICICI Bank, Chennai Main</span>
        </div>
      </div>
    </div>

    <!-- Submit Payment Proof Form Card -->
    <% if (registrations && registrations.length > 0) { %>
      <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px;">
        <h3 class="erp-h3" style="margin: 0 0 4px 0; color: #000000; display: flex; align-items: center; gap: 8px;">
          <i data-lucide="file-up" style="width: 18px; height: 18px; color: #000000;"></i>
          Submit Payment Screenshot
        </h3>
        <p style="margin: 0 0 16px 0; font-size: 12px; color: #64748B;">Upload your transaction screenshot with 12-digit UTR reference for admin verification.</p>

        <form id="globalProofForm" onsubmit="submitGlobalProof(event)" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Select Program</label>
            <select name="registration_id" required class="erp-input" style="font-size: 13px;">
              <% registrations.forEach(reg => { %>
                <option value="<%= reg.id %>"><%= reg.course_title %> (Due: ₹<%= reg.balance_amount %>)</option>
              <% }); %>
            </select>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Amount Paid (₹)</label>
              <input type="number" name="amount" required min="1" placeholder="Amount" class="erp-input" style="font-size: 13px; font-weight: 700;">
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Payment Method</label>
              <select name="payment_method" required class="erp-input" style="font-size: 13px;">
                <option value="upi">UPI (GPay / PhonePe / Paytm)</option>
                <option value="netbanking">Net Banking (IMPS / NEFT)</option>
                <option value="cash">Direct Deposit</option>
                <option value="card">Card</option>
              </select>
            </div>
          </div>

          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">12-Digit UTR / Transaction Reference *</label>
            <input type="text" name="transaction_id" required placeholder="e.g. 412345678901" class="erp-input" style="font-size: 13px; font-family: monospace;">
          </div>

          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Attach Screenshot (PNG, JPG, PDF) *</label>
            <input type="file" name="receipt" required accept="image/*, application/pdf" class="erp-input" style="font-size: 12px; padding: 6px 10px;">
          </div>

          <button type="submit" id="btnSubmitGlobalProof" class="erp-btn erp-btn-primary" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 600; background: #000000; color: #FFFFFF; border-radius: 8px; margin-top: 4px;">
            <i data-lucide="send" style="width: 14px; height: 14px;"></i> Upload for Admin Verification
          </button>
        </form>
      </div>
    <% } %>
  </div>

</div>

<style>
  @media (max-width: 900px) {
    .payments-grid-wrapper {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 768px) {
    .erp-grid-3 { grid-template-columns: 1fr !important; gap: 12px !important; }
    .erp-h1 { font-size: 20px !important; margin-bottom: 16px !important; }
    .erp-grid-3 .erp-card { padding: 16px !important; }
  }
</style>

<script>
  function copyUpiText(text, btn) {
    navigator.clipboard.writeText(text);
    const orig = btn.innerHTML;
    btn.innerHTML = '<i data-lucide="check" style="width: 12px; height: 12px;"></i> Copied!';
    if (window.lucide) lucide.createIcons();
    setTimeout(() => {
      btn.innerHTML = orig;
      if (window.lucide) lucide.createIcons();
    }, 2000);
  }

  async function submitGlobalProof(e) {
    e.preventDefault();
    const form = document.getElementById('globalProofForm');
    const btn = document.getElementById('btnSubmitGlobalProof');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Submitting Proof...';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/payments/submit-proof', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.success) {
        alert("Payment screenshot submitted successfully! ✅\n\nOur Admin team will review and verify your payment shortly.");
        window.location.reload();
      } else {
        alert(data.message || "Failed to submit payment proof.");
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    } catch (err) {
      console.error(err);
      alert("Network error submitting payment proof.");
      btn.disabled = false;
      btn.innerHTML = origText;
    }
  }
</script>
