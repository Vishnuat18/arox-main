# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Database (Use either DATABASE_URL or individual DB_* variables)
DATABASE_URL=postgres://user:password@host:5432/Arox_database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=Arox_database
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@aroxtech.com

# Organization
ORG_NAME=AROX Tech Pvt. Ltd.
ORG_ADDRESS=Chennai, Tamil Nadu, India
ORG_PHONE=+91 98765 43210
ORG_EMAIL=info@aroxtech.com
ORG_WEBSITE=https://aroxtech.com
ORG_GSTIN=33AABCU9603R1ZM

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
