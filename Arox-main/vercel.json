{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**",
          "config/**",
          "database/**",
          "routes/**",
          "controllers/**",
          "middleware/**",
          "utils/**",
          "*.html",
          "css/**",
          "js/**",
          "assets/**",
          "cert/**",
          "attendance/**",
          "offerletter/**",
          "project/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
